+++ b/moorestech_client/Assets/Scripts/Client.Network/Api/HiveInspectionReport.cs
@@ -0,0 +1,26 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace Client.Network.Api
+{
+    public class HiveInspectionReport
+    {
+        public List<HoneyCell> Cells { get; }
+        public int QueenAgeDays { get; }
+
+        public HiveInspectionReport(List<HoneyCell> cells, int queenAgeDays)
+        {
+            Cells = cells;
+            QueenAgeDays = queenAgeDays;
+        }
+
+        public HiveInspectionReport(HiveSnapshotMessagePack snapshot)
+        {
+            // wire応答からの変換はDTO側に置く
+            // Conversion from the wire response lives in the DTO
+            Cells = snapshot.Cells.Select(c => new HoneyCell(c.Id, c.FillRatio)).ToList();
+            QueenAgeDays = snapshot.QueenAgeDays;
+        }
+    }
+}
diff --git a/moorestech_client/Assets/Scripts/Client.Network/Api/ApiaryApiClient.cs b/moorestech_client/Assets/Scripts/Client.Network/Api/ApiaryApiClient.cs
new file mode 100644
--- /dev/null
+++ b/moorestech_client/Assets/Scripts/Client.Network/Api/ApiaryApiClient.cs
@@ -0,0 +1,15 @@
+using System;
+
+namespace Client.Network.Api
+{
+    public class ApiaryApiClient
+    {
+        public HiveInspectionReport RequestInspection(int hiveId)
+        {
+            var snapshot = SendInspectionRequest(hiveId);
+            // production経路は必ずsnapshot版コンストラクタを使う
+            // The production path always uses the snapshot constructor
+            return new HiveInspectionReport(snapshot);
+        }
+    }
+}
diff --git a/moorestech_client/Assets/Scripts/Client.Game/Apiary/HiveManualEntryForm.cs b/moorestech_client/Assets/Scripts/Client.Game/Apiary/HiveManualEntryForm.cs
