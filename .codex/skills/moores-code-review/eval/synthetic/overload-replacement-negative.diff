+using System.Collections.Generic;
+using Client.Network.Api;
+
+namespace Client.Game.Apiary
+{
+    public class HiveManualEntryForm
+    {
+        public HiveInspectionReport BuildReportFromForm(List<HoneyCell> enteredCells, int enteredQueenAge)
+        {
+            // 手入力経路はwire応答を持たないため生引数版を使う
+            // The manual-entry path has no wire response, so it uses the raw-args constructor
+            return new HiveInspectionReport(enteredCells, enteredQueenAge);
+        }
+    }
+}
