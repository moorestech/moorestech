+using MessagePack;
+
+namespace Server.Protocol.PacketResponse
+{
+    // 望遠鏡の操作プロトコル
+    // Protocol for telescope operations
+    public class ObservatoryProtocol : IPacketResponse
+    {
+        public const string ProtocolTag = "va:observatory";
+
+        public ProtocolMessagePackBase GetResponse(MemoryStream payload)
+        {
+            var data = MessagePackSerializer.Deserialize<ObservatoryProtocolMessagePack>(payload.ToArray());
+
+            // 実処理は焦点距離の変更のみ
+            // The only actual operation is changing the focus distance
+            _telescopeService.SetFocusDistance(data.PlayerId, data.FocusDistance);
+            return null;
+        }
+    }
+}
