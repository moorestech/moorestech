@@ -0,0 +1,33 @@
+using System;
+using UniRx;
+
+namespace Client.Game.Observatory
+{
+    public class TelescopeState
+    {
+        public int TrackingTargetId { get; private set; }
+        public float FocusDistance { get; private set; }
+
+        public IObservable<Unit> OnChanged => _onChanged;
+        private readonly Subject<Unit> _onChanged = new();
+
+        public void SetTrackingTarget(int targetId)
+        {
+            TrackingTargetId = targetId;
+            _onChanged.OnNext(Unit.Default);
+        }
+
+        public void SetFocusDistance(float distance)
+        {
+            FocusDistance = distance;
+            _onChanged.OnNext(Unit.Default);
+        }
+
+        public void ResetToHomePosition()
+        {
+            TrackingTargetId = -1;
+            FocusDistance = 0f;
+            _onChanged.OnNext(Unit.Default);
+        }
+    }
+}
