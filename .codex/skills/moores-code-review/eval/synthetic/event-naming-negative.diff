@@ -0,0 +1,18 @@
+using MessagePack;
+
+namespace Server.Protocol.PacketResponse
+{
+    // 焦点距離変更プロトコル（名前が実処理と一致）
+    // Focus-distance protocol; the name matches the actual operation
+    public class SetFocusDistanceProtocol : IPacketResponse
+    {
+        public const string ProtocolTag = "va:setFocusDistance";
+
+        public ProtocolMessagePackBase GetResponse(MemoryStream payload)
+        {
+            var data = MessagePackSerializer.Deserialize<SetFocusDistanceProtocolMessagePack>(payload.ToArray());
+            _telescopeService.SetFocusDistance(data.PlayerId, data.FocusDistance);
+            return null;
+        }
+    }
+}
