+using System;
+using UniRx;
+
+namespace Client.Game.Observatory
+{
+    public class TelescopeState
+    {
+        public int TrackingTargetId { get; private set; }
+        public float FocusDistance { get; private set; }
+
+        public IObservable<Unit> OnTrackingTargetChanged => _onTrackingTargetChanged;
+        private readonly Subject<Unit> _onTrackingTargetChanged = new();
+
+        public IObservable<Unit> OnFocusDistanceChanged => _onFocusDistanceChanged;
+        private readonly Subject<Unit> _onFocusDistanceChanged = new();
+
+        public void SetTrackingTarget(int targetId)
+        {
+            TrackingTargetId = targetId;
+            _onTrackingTargetChanged.OnNext(Unit.Default);
+        }
+
+        public void SetFocusDistance(float distance)
+        {
+            FocusDistance = distance;
+            _onFocusDistanceChanged.OnNext(Unit.Default);
+        }
+    }
+}
diff --git a/moorestech_server/Assets/Scripts/Server.Protocol/PacketResponse/SetFocusDistanceProtocol.cs b/moorestech_server/Assets/Scripts/Server.Protocol/PacketResponse/SetFocusDistanceProtocol.cs
