{
  "$id": "items",
  "type": "object",
  "isDefaultOpen": true,
  "properties": {
    "data": {
      "type": "array",
      "overrideCodeGeneratePropertyName": "ItemMasterElement",
      "items": {
        "type": "object",
        "thumbnail": "imagePath",
        "properties": {
          "itemGuid": {
            "type": "string",
            "format": "uuid",
            "autoGenerated": true
          },
          "imagePath": {
            "type": "string",
            "pattern": "@imagePath",
            "thumbnail": true,
            "optional": true
          },
          "name": {
            "type": "string"
          },
          "maxStack": {
            "type": "integer",
            "default": 100
          },
          "sortPriority": {
            "type": "number",
            "default": 100,
            "optional": true
          },
          "initialUnlocked": {
            "type": "boolean",
            "default": true
          },
          "recipeViewType": {
            "type": "string",
            "default": 100,
            "enum": [
              "Default",
              "IsUnlocked",
              "IsCraftRecipeExist",
              "ForceShow",
              "ForceHide"
            ]
          }
        }
      }
    },
    "orbitalPayloads": {
      "type": "array",
      "overrideCodeGeneratePropertyName": "OrbitalPayloadMasterElement",
      "items": {
        "type": "object",
        "properties": {
          "payloadItemGuid": {
            "type": "string",
            "format": "uuid",
            "foreignKey": {
              "schemaId": "items",
              "foreignKeyIdPath": "/data/[*]/itemGuid",
              "displayElementPath": "/data/[*]/name"
            }
          },
          "countPerLaunch": {
            "type": "integer",
            "default": 1
          },
          "arrivalOutputs": {
            "type": "array",
            "overrideCodeGeneratePropertyName": "OrbitalArrivalOutputElement",
            "items": {
              "type": "object",
              "properties": {
                "itemGuid": {
                  "type": "string",
                  "format": "uuid",
                  "foreignKey": {
                    "schemaId": "items",
                    "foreignKeyIdPath": "/data/[*]/itemGuid",
                    "displayElementPath": "/data/[*]/name"
                  }
                },
                "count": {
                  "type": "integer",
                  "default": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
