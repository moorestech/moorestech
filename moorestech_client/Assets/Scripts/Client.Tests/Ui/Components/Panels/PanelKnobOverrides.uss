/* L1 のつまみ上書き検査用。画面 USS が祖先でつまみを変える形を写す（値は Web の InventoryPanel・ItemListPanel の inline style） */
/* For the L1 knob-override checks; mirrors a screen USS changing knobs on an ancestor (values from the Web InventoryPanel and ItemListPanel inline styles) */

.test-knob-panel-left {
    --panel-left: -2.22px;
}

.test-knob-title {
    --title-shift-x: -1.96px;
    --title-scale-x: 0.919;
    --title-scale-y: 0.924;
}

.test-knob-paper {
    --paper-face: var(--mantine-color-dark-8);
    --paper-radius: 10px;
}

/* GamePanelSurface の面の 4 値を部品ルートのつまみで渡す（種別の 1 クラスへ 2 クラスで勝つ。スキットの選択肢の板と同じ形） */
/* Passes the GamePanelSurface face's four values through the component root knobs (two classes beat the one-class kind, as the skit choice plate does) */
.test-knob-surface > .game-panel-surface {
    --game-panel-surface-face: var(--gauge-track);
    --game-panel-surface-edge-fade: 3px;
    --game-panel-surface-top-fade: 0px;
    --game-panel-surface-bottom-fade: 5px;
}
