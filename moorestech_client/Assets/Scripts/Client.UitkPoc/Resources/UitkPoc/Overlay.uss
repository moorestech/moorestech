.ov-root {
    flex-grow: 1;
    flex-direction: row;
    padding: 12px;
}

.ov-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
    padding: 12px;
    border-radius: 10px;
    background-color: #242830;
}

.ov-column__title {
    margin-bottom: 10px;
    -unity-font-style: bold;
    color: #f2a640;
    white-space: normal;
}

.ov-layer, .ov-tooltip-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ov-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.ov-slot {
    width: 64px;
    height: 64px;
    margin: 3px;
    border-radius: 6px;
    border-width: 2px;
    border-color: #3a404a;
    background-color: #1b1e23;
    transition-property: border-color, background-color;
    transition-duration: 0.1s;
}

.ov-slot:hover {
    border-color: #6b7380;
}

.ov-slot--dragging {
    opacity: 0.35;
}

.ov-slot--drop-target {
    border-color: #f2a640;
    background-color: #3a2f1c;
}

.ov-slot__icon {
    flex-grow: 1;
    margin: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.ov-slot__count {
    position: absolute;
    right: 2px;
    bottom: 2px;
    padding: 0 4px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.7);
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
}

.ov-slot__count--empty {
    display: none;
}

.ov-ghost {
    position: absolute;
    width: 56px;
    height: 56px;
    opacity: 0.85;
    scale: 1.15 1.15;
    -unity-background-scale-mode: scale-to-fit;
}

.ov-tooltip {
    position: absolute;
    max-width: 320px;
    padding: 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #4a525e;
    background-color: rgba(18, 20, 24, 0.96);
}

.ov-tooltip Label {
    color: #e8eaed;
    white-space: normal;
}

.ov-tooltip__title {
    font-size: 17px;
    margin-bottom: 4px;
}

.ov-vlist {
    flex-grow: 1;
}

.ov-vlist__status {
    margin: 6px 0;
    font-size: 12px;
    color: #8fe08f;
}

.ov-vlist__list {
    flex-grow: 1;
    border-radius: 6px;
    background-color: #1b1e23;
}

.ov-vlist__row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 8px;
}

.ov-vlist__icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.ov-vlist__row #name {
    flex-grow: 1;
    color: #d6dae0;
}

.ov-vlist__row #amount {
    color: #f2c27a;
}

.ov-window-area {
    overflow: hidden;
}

.ov-window {
    position: absolute;
    border-radius: 8px;
    border-width: 1px;
    border-color: #4a525e;
    background-color: #2c313a;
    overflow: hidden;
}

.ov-window__title {
    padding: 6px 10px;
    background-color: #3c6fb0;
    color: #ffffff;
    -unity-font-style: bold;
}

.ov-window__body {
    padding: 10px;
    color: #d6dae0;
    white-space: normal;
}

.ov-window__grip {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 16px;
    height: 16px;
    background-color: #6b7380;
    border-top-left-radius: 8px;
}

.ov-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    transition-property: opacity, visibility;
    transition-duration: 0.2s;
}

.ov-backdrop--hidden {
    opacity: 0;
    visibility: hidden;
}

.ov-dialog {
    width: 480px;
    padding: 20px;
    border-radius: 12px;
    background-color: #2c313a;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.ov-backdrop--hidden .ov-dialog {
    scale: 0.9 0.9;
}

.ov-dialog Label {
    margin-bottom: 8px;
    color: #e8eaed;
    font-size: 16px;
    white-space: normal;
}

.ov-dialog__buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}
