.ne-root {
    flex-grow: 1;
}

.ne-toolbar {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 10px;
    background-color: #20242a;
    border-bottom-width: 1px;
    border-color: #3d434d;
}

.ne-toolbar > * {
    margin-right: 8px;
}

.ne-status {
    flex-grow: 1;
    -unity-text-align: middle-right;
    color: #8fe08f;
    font-size: 12px;
}

.ne-canvas-host {
    flex-grow: 1;
}

.ne-canvas {
    flex-grow: 1;
    overflow: hidden;
    background-color: #181a1f;
}

.ne-grid {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ne-world {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.ne-edges {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.ne-node {
    position: absolute;
    border-radius: 8px;
    border-width: 1px;
    border-color: #444b56;
    background-color: #2a2f37;
}

.ne-node--selected {
    border-color: #f2a640;
    border-width: 2px;
}

.ne-node__header {
    height: 28px;
    padding: 0 10px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    background-color: #3c6fb0;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.ne-port {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: #1b1d22;
    background-color: #8a94a3;
}

.ne-port--in {
    left: -7px;
}

.ne-port--out {
    right: -7px;
    background-color: #5fbf7f;
}

.ne-port:hover, .ne-port--target {
    background-color: #f2a640;
    scale: 1.3 1.3;
}

.ne-port-label {
    position: absolute;
    font-size: 12px;
    color: #9aa3ad;
}

.ne-port-label--in {
    left: 12px;
}

.ne-port-label--out {
    right: 12px;
}

.ne-node__grip {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 14px;
    height: 14px;
    border-bottom-right-radius: 7px;
    border-top-left-radius: 4px;
    background-color: #555d6a;
}

.ne-marquee {
    position: absolute;
    border-width: 1px;
    border-color: #4fa3ff;
    background-color: rgba(79, 163, 255, 0.12);
}

.ne-minimap {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 240px;
    height: 160px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #3d434d;
    background-color: rgba(20, 22, 26, 0.95);
}

.ne-hint {
    padding: 6px 10px;
    font-size: 12px;
    color: #9aa3ad;
    background-color: #20242a;
    white-space: normal;
}
