/* web: features/modal/ModalHost.tsx（Mantine Modal.Root centered の Overlay backgroundOpacity 0.6 と inner の中央寄せ。transition は duration 0） */
/* web: features/modal/ModalHost.tsx (Mantine Modal.Root centered: Overlay backgroundOpacity 0.6 and the centred inner; transition duration 0) */
/* モーダルの宿主。隠れている間は木から外さず表示だけ止める（層の中の位置を保つ） */
/* Modal host; while hidden it stays in the tree with display off (keeps its place in the layer) */
.ui-modal-host {
    display: none;
}

.ui-modal-host.ui-modal-host--shown {
    display: flex;
}

/* 幕は画面いっぱい。色は Web Modal.Overlay の #000・0.6 のつまみ */
/* The backdrop fills the screen; its color is the knob holding the Web Modal.Overlay #000 at 0.6 */
.ui-modal-host__backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--modal-backdrop-face);
}

/* Mantine の inner は中身を縦横の中央に置く（centered） */
/* The Mantine inner centres the contents both ways (centered) */
.ui-modal-host__center {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
