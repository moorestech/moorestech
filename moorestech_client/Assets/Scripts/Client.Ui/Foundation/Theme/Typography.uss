/* 文字の既定。フォントは Latin→JP→KR のフォールバック、CJK のロケールは JP を先頭にする（plan.md §3.10）。合成の太字は使わない */
/* Text defaults; fonts fall back Latin→JP→KR and CJK locales lead with JP (plan.md §3.10); no synthetic bold */
:root {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GameUi/Fonts/GameUiLatin%20SDF.asset");
    font-size: 14px;
    color: var(--text-default);
}

.game-ui-locale--cjk {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GameUi/Fonts/GameUiJapanese%20SDF.asset");
}

/* Mantine の Text/Title の写し（UiTypographyClass）。Text の root は margin 0・padding 0 で、行の高さは USS に無いので min-height = 字 × line-height */
/* Title は Web と同じ px。Web は Regular 1 字形で題を描き、GameUi は Bold の字形（約 3.3% em ずつ字送りが広い）なので letter-spacing で詰めて題の幅を Web に寄せる（設計書 A-37）。UITK の letter-spacing は px と書いても字の大きさの 1/100 単位で効くので、4 段とも同じ -3.6 で、Regular と幅が 3% 以内になる（C2-c Task 11 の実測） */
/* Copies of Mantine Text/Title (UiTypographyClass); the Text root has margin 0 and padding 0, and USS has no line-height so min-height = size x line-height */
/* Titles use the Web px; the Web draws titles with its single Regular face while GameUi uses Bold (about 3.3% em wider per glyph), so letter-spacing tightens the title width to the Web's (design A-37); UITK applies letter-spacing in 1/100 of the font size even when written as px, so one -3.6 for all four steps keeps the width within 3% of Regular (measured in C2-c Task 11) */
.text--xs,
.text--sm,
.text--md,
.title--order-1,
.title--order-2,
.title--order-3,
.title--order-4 {
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-left;
}

.text--xs {
    font-size: var(--mantine-font-size-xs);
    min-height: 16.8px;
}

.text--sm {
    font-size: var(--mantine-font-size-sm);
    min-height: 20.3px;
}

.text--md {
    font-size: var(--mantine-font-size-md);
    min-height: 24.8px;
}

.title--order-1 {
    --title-order-1-row-height: 44.2px;
    font-size: 34px;
    min-height: var(--title-order-1-row-height);
}

.title--order-2 {
    --title-order-2-row-height: 35.1px;
    font-size: 26px;
    min-height: var(--title-order-2-row-height);
}

.title--order-3 {
    font-size: 22px;
    min-height: 30.8px;
}

.title--order-4 {
    font-size: 18px;
    min-height: 26.1px;
}

/* 4 段の字間は 1 つの名前で持つ。祖先から上書きするつまみではないので、題のクラス自身で宣言する */
/* The four steps share one named spacing; it is not an ancestor-overridable knob, so the title classes declare it themselves */
.title--order-1,
.title--order-2,
.title--order-3,
.title--order-4 {
    --title-letter-spacing: -3.6px;
    letter-spacing: var(--title-letter-spacing);
}

.text--dimmed {
    color: var(--mantine-color-dimmed);
}

.text--white {
    color: var(--mantine-color-white);
}

.text--default {
    color: var(--text-default);
}

.text--muted {
    color: var(--text-muted);
}

.text--insufficient {
    color: var(--text-insufficient);
}

.text--high-contrast {
    color: var(--text-high-contrast);
}

/* 大きさのクラスより後に置き、揃えを上書きする */
/* Placed after the size classes so it overrides their alignment */
.text--center {
    -unity-text-align: middle-center;
}

/* app/tokens.css の :where(.keyHintText)。並びの箱に付け、中の文字と KeyCap が継ぐ（line-height 1.2 は置く側の行で持つ） */
/* app/tokens.css :where(.keyHintText); attach it to the row so its text and KeyCap inherit (the row owns line-height 1.2) */
.key-hint-text {
    font-size: var(--key-hint-font-size);
    letter-spacing: var(--key-hint-letter-spacing);
    color: var(--text-high-contrast);
    text-shadow: var(--key-hint-text-shadow-face); /* look-exception: LX-86 */
}

/* Mantine の Title（700）と fw={500}/{700}、keyHintText（500）の太さ。合成の太字は使わず太さ違いの字形を当てる（設計書 A-36） */
/* Weights of Mantine Title (700), fw={500}/{700} and keyHintText (500); weight-variant faces are used instead of synthetic bold (design A-36) */
.title--order-1,
.title--order-2,
.title--order-3,
.title--order-4,
.text--bold {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GameUi/Fonts/GameUiLatinBold%20SDF.asset");
}

.text--medium,
.key-hint-text {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GameUi/Fonts/GameUiLatinMedium%20SDF.asset");
}

/* CJK のロケールは段階 1 と同じく JP の字形を先頭にする（JP/KR は元から Medium なので 500 は段階 1 の JP のまま） */
/* CJK locales lead with the JP face as in stage 1 (JP/KR are already Medium, so 500 stays on the stage-1 JP face) */
/* look-exception: LX-171 */
.game-ui-locale--cjk .title--order-1,
.game-ui-locale--cjk .title--order-2,
.game-ui-locale--cjk .title--order-3,
.game-ui-locale--cjk .title--order-4,
.game-ui-locale--cjk .text--bold {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GameUi/Fonts/GameUiJapaneseBold%20SDF.asset");
}

.game-ui-locale--cjk .text--medium,
.game-ui-locale--cjk .key-hint-text {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/GameUi/Fonts/GameUiJapanese%20SDF.asset");
}

/* 和文は字送りが全角 1 字で Web の Medium と GameUi の Bold が同じ幅なので、題の字間を詰めない（C2-c Task 11 の実測） */
/* CJK glyphs advance one full em, so the Web Medium and GameUi Bold widths match and titles are not tightened (measured in C2-c Task 11) */
.game-ui-locale--cjk .title--order-1,
.game-ui-locale--cjk .title--order-2,
.game-ui-locale--cjk .title--order-3,
.game-ui-locale--cjk .title--order-4 {
    letter-spacing: 0;
}
