/* Web が color-mix・半透明・直書きで出す色の手書きの前計算。各行に web の元の式と決め方を残す（設計書 §3.1） */
/* Hand-written precomputations of colors the Web derives with color-mix, translucency or literals; each row keeps the web source and how it was settled (design §3.1) */
:root {
    /* GamePanel（default）の文字・罫線・下部の三角。Web の GamePanel/style.module.css が直書きする色 */
    --game-panel-text: #e8eaf0;
    --game-panel-title-shadow: rgba(0, 0, 0, 0.3735); /* web: rgba(0, 0, 0, 0.35) 面色(10,14,27)を背景にした厳密式 */
    --game-panel-rule-top-start: rgba(146, 148, 167, 0.1961); /* web: rgba(146, 148, 167, 0.42) 面色を背景にした厳密式（S7） */
    --game-panel-rule-top-peak: rgba(146, 148, 167, 0.3602); /* web: rgba(146, 148, 167, 0.59) 面色を背景にした厳密式（S7） */
    --game-panel-rule-top-end: rgba(146, 148, 167, 0.1653); /* web: rgba(146, 148, 167, 0.38) 面色を背景にした厳密式（S7） */
    --game-panel-rule-bottom-start: rgba(128, 132, 159, 0.1178); /* web: rgba(128, 132, 159, 0.3) 面色を背景にした厳密式（S7） */
    --game-panel-rule-bottom-peak: rgba(128, 132, 159, 0.2034); /* web: rgba(128, 132, 159, 0.42) 面色を背景にした厳密式（S7） */
    --game-panel-rule-bottom-end: rgba(128, 132, 159, 0.0946); /* web: rgba(128, 132, 159, 0.26) 面色を背景にした厳密式（S7） */
    --game-panel-triangle-face: rgba(94, 100, 128, 0.0764); /* web: rgba(94, 100, 128, 0.2) 面色(10,14,27)を背景にした厳密式 */

    /* PanelActionButton・ModeSwitch の Web の color-mix(in srgb, var(--gauge-track), var(--bevel-c2) N%) を前計算した面と、PanelActionButton の文字の縁 */
    --panel-action-hover-face: rgba(35, 38, 51, 0.9678); /* web: color-mix 22% = rgba(35, 38, 51, 0.844) α補正 */
    --mode-switch-selected-face: rgba(43, 46, 59, 0.9737); /* web: color-mix 30% = rgba(43, 46, 59, 0.86) α補正 */
    --panel-action-text-outline: rgba(0, 0, 0, 0.8922); /* web: rgb(0 0 0 / 70%) α補正 */

    /* ポーズの枠の面と線。Web の pauseMenu/style.module.css の .panel が直書きする色 */
    --pause-menu-face: rgba(16, 20, 28, 0.9907); /* web: rgb(16 20 28 / 92%) α補正 */
    --pause-menu-border: rgb(73, 76, 82); /* web: rgb(255 255 255 / 24%) over (16,20,28) */

    /* Mantine ScrollArea の暗色のつまみ。Web: rgba(255, 255, 255, 0.4) を明るい色の α 補正（α^2.2）で写す */
    --theme-scroller-thumb-face: rgba(255, 255, 255, 0.1332); /* web: rgba(255, 255, 255, 0.4) α補正 */

    /* C2-a: 面・装飾（Panels・Decor）。つまみの既定は Web の var() のフォールバックか Mantine の既定、色は Web の CSS module の直書きを前計算した値（設計書 A-23・A-24・A-25） */
    /* C2-a: surfaces and decor (Panels, Decor); knob defaults are the Web var() fallbacks or Mantine defaults, colors precompute literals in the Web CSS modules (design A-23, A-24, A-25) */
    --panel-top: -8px; /* web: GamePanel/style.module.css の var(--panel-top, -8px) */
    --panel-right: -3px; /* web: var(--panel-right, -3px) */
    --panel-bottom: -8px; /* web: var(--panel-bottom, -8px) */
    --panel-left: -3px; /* web: var(--panel-left, -3px) */
    --title-shift-x: 0px; /* web: .title の var(--title-shift-x, 0) */
    --title-scale-x: 0.947; /* web: .title の var(--title-scale-x, 0.947) */
    --title-scale-y: 0.947; /* web: .title の var(--title-scale-y, 0.947) */
    --game-panel-craft-face: rgba(7, 9, 18, 0.9491); /* web: .craft の background rgb(7 9 18 / 80%) α補正（S7 の近似式 1-(1-α)^1.85） */
    --game-panel-craft-line: rgb(40, 42, 53); /* web: .craft の inset 0 0 0 3.132px rgb(40 42 53) */
    --game-panel-craft-rim: rgba(146, 148, 167, 0.2684); /* web: .craft の inset 0 0 0 3.524px rgb(146 148 167 / 55%) α補正（S7 の近似式 α^2.2） */
    --paper-face: var(--mantine-color-body); /* web: Mantine Paper の background-color。Web に局所変数は無く、画面は background を直に上書きする（設計書 A-23） */
    --paper-radius: var(--mantine-radius-sm); /* web: Mantine Paper の --paper-radius: var(--mantine-radius-default)。8.3.18 の既定 theme では sm と同じ 0.25rem */
    --hud-label-font-size: var(--challenge-hud-label-font-size); /* web: CurrentChallengeHud.module.css .label。PlacementModeHud の --operation-hud-* は同値 */
    --hud-label-letter-spacing: var(--challenge-hud-letter-spacing); /* web: 同上。値は字の大きさの 1/100 単位（12px で 1px）なので、--hud-label-font-size だけを上書きするときは字間も上書きする */
    --hud-label-rule-gap: var(--challenge-hud-label-rule-gap); /* web: 同上 */
    --hud-rule-list-gap: var(--challenge-hud-rule-list-gap); /* web: .objectives の margin-top */
    --hud-rule-width: 100%; /* web: modeHud は FadeRule を幅いっぱい、challenge は .rule の --challenge-hud-rule-width（画面 USS が上書き） */

    /* C2-b: Mantine Button の Subtle のホバー。生成器は半透明で止まるのでここに Web と同名で手書きする */
    /* C2-b: Mantine Button Subtle hover; the generator stops on translucent values, so it is hand-written here under the Web name */
    --mantine-color-blue-light-hover: rgba(34, 139, 230, 0.029); /* web: dark の rgba(34, 139, 230, 0.2) を明るい色の α 補正（α^2.2。--theme-scroller-thumb-face と同じ） */

    /* C2-c: GameScrollView のバーの幅（Mantine ScrollArea の既定 0.75rem）・つまみのホバー・ShortcutHintLabel の kbd と文の間（設計書 A-34・A-35） */
    /* C2-c: GameScrollView bar width (Mantine ScrollArea default 0.75rem), thumb hover, and the kbd-to-text gap of ShortcutHintLabel (design A-34, A-35) */
    --scrollarea-scrollbar-size: 12px; /* web: Mantine ScrollArea の scrollbarSize の既定。画面は祖先で上書きする */
    --game-scroll-view-thumb-hover: rgb(133, 135, 141); /* web: rgba(255, 255, 255, 0.5) を溝（--gauge-track）とポーズの面へ重ねて前計算 */
    --shortcut-hint-label-gap: 0px; /* web: 置く側の flex の gap。既定 0（KeyControlHint が --tutorial-key-hint-kbd-gap に上書き） */

    /* C3-b: 相互作用（ModeSwitch の選択肢の高さ・DialogFrame・モーダルの幕）。つまみの既定は Web の var() のフォールバックか Mantine Modal の既定（設計書 A-52） */
    /* C3-b: interaction (ModeSwitch option height, DialogFrame, modal backdrop); knob defaults are the Web var() fallbacks or Mantine Modal defaults (design A-52) */
    --mode-switch-option-height: 34.8px; /* web: ModeSwitch .option の var(--mode-switch-option-height, auto)。auto の実寸＝padding-block 5px×2＋本文の行 16px×1.55（C2-c の実測）。ビルドメニューは --build-menu-category-height へ上書き */
    --modal-size: 440px; /* web: Mantine Modal の --modal-size（size 既定 md = 27.5rem）。ModalHost の w={320} は Mantine の content の flex: 0 0 var(--modal-size) に負け、参照 3-modal の実寸は 440px */
    --modal-radius: var(--mantine-radius-default); /* web: Mantine Modal の --modal-radius の既定 */
    --mb-padding: var(--mantine-spacing-md); /* web: Mantine ModalBase の --mb-padding（padding 既定 md）。題の行の余白 */
    --dialog-frame-header-min-height: 60px; /* web: Mantine ModalBase の header の min-height: 60px（直書き） */
    --dialog-frame-body-padding: var(--mantine-spacing-lg); /* web: ModalHost の Modal.Body p="lg" */
    --dialog-frame-face: var(--mantine-color-body); /* web: Mantine ModalBase の content の背景（参照 3-modal の面 rgb(36,36,36)） */
    --modal-backdrop-face: rgba(0, 0, 0, 0.8164); /* web: Modal.Overlay backgroundOpacity={0.6} の #000 を暗い色の式 1-(1-α)^1.85 で α 補正（A-72・A-73。handWrittenDerivedRows.mjs の formula 行が値を照合する。手で選び直さない） */
}
