/* Web が color-mix・半透明・直書きで出す色の手書きの前計算。各行に web の元の式と決め方を残す（設計書 §3.1） */
/* Hand-written precomputations of colors the Web derives with color-mix, translucency or literals; each row keeps the web source and how it was settled (design §3.1) */
:root {
    /* GamePanel（default）の文字・罫線・下部の三角。Web の GamePanel/style.module.css が直書きする色 */
    --game-panel-text: #e8eaf0;
    --game-panel-title-shadow: rgba(0, 0, 0, 0.35); /* web: GamePanel .title の text-shadow の色 */
    --game-panel-rule-top-start: rgba(146, 148, 167, 0.42); /* web: .rule の上の線の始点 */
    --game-panel-rule-top-peak: rgba(146, 148, 167, 0.59); /* web: 上の線の頂点 */
    --game-panel-rule-top-end: rgba(146, 148, 167, 0.38); /* web: 上の線の終点 */
    --game-panel-rule-bottom-start: rgba(128, 132, 159, 0.3); /* web: 下の線の始点 */
    --game-panel-rule-bottom-peak: rgba(128, 132, 159, 0.42); /* web: 下の線の頂点 */
    --game-panel-rule-bottom-end: rgba(128, 132, 159, 0.26); /* web: 下の線の終点 */
    --game-panel-triangle-face: rgba(94, 100, 128, 0.2); /* web: 下部の三角の面 */

    /* PanelActionButton・ModeSwitch の Web の color-mix(in srgb, var(--gauge-track), var(--bevel-c2) N%) を前計算した面と、PanelActionButton の文字の縁 */
    --panel-action-hover-face: rgba(35, 38, 51, 0.844); /* web: color-mix 22% = rgba(35, 38, 51, 0.844) */
    --mode-switch-selected-face: rgba(43, 46, 59, 0.86); /* web: color-mix 30% = rgba(43, 46, 59, 0.86) */
    --panel-action-text-outline: rgba(0, 0, 0, 0.7); /* web: rgb(0 0 0 / 70%) */

    /* ポーズの枠の面と線。Web の pauseMenu/style.module.css の .panel が直書きする色 */
    --pause-menu-face: rgba(16, 20, 28, 0.92); /* web: rgb(16 20 28 / 92%) */
    --pause-menu-border: rgb(73, 76, 82); /* web: rgb(255 255 255 / 24%) over (16,20,28) */

    /* Mantine ScrollArea の暗色のつまみ */
    --theme-scroller-thumb-face: rgba(255, 255, 255, 0.4); /* web: rgba(255, 255, 255, 0.4) */

    /* C2-a: 面・装飾（Panels・Decor）。つまみの既定は Web の var() のフォールバックか Mantine の既定、色は Web の CSS module の直書きを前計算した値（設計書 A-23・A-24・A-25） */
    /* C2-a: surfaces and decor (Panels, Decor); knob defaults are the Web var() fallbacks or Mantine defaults, colors precompute literals in the Web CSS modules (design A-23, A-24, A-25) */
    --panel-top: -8px; /* web: GamePanel/style.module.css の var(--panel-top, -8px) */
    --panel-right: -3px; /* web: var(--panel-right, -3px) */
    --panel-bottom: -8px; /* web: var(--panel-bottom, -8px) */
    --panel-left: -3px; /* web: var(--panel-left, -3px) */
    --title-shift-x: 0px; /* web: .title の var(--title-shift-x, 0) */
    --title-scale-x: 0.947; /* web: .title の var(--title-scale-x, 0.947) */
    --title-scale-y: 0.947; /* web: .title の var(--title-scale-y, 0.947) */
    --game-panel-craft-face: rgba(7, 9, 18, 0.8); /* web: .craft の background rgb(7 9 18 / 80%) */
    --game-panel-craft-line: rgb(40, 42, 53); /* web: .craft の inset 0 0 0 3.132px rgb(40 42 53) */
    --game-panel-craft-rim: rgba(146, 148, 167, 0.55); /* web: .craft の inset 0 0 0 3.524px rgb(146 148 167 / 55%) */
    --paper-face: var(--mantine-color-body); /* web: Mantine Paper の background-color。Web に局所変数は無く、画面は background を直に上書きする（設計書 A-23） */
    --paper-radius: var(--mantine-radius-sm); /* web: Mantine Paper の --paper-radius: var(--mantine-radius-default)。8.3.18 の既定 theme では sm と同じ 0.25rem */
    --hud-label-font-size: var(--challenge-hud-label-font-size); /* web: CurrentChallengeHud.module.css .label。PlacementModeHud の --operation-hud-* は同値 */
    --hud-label-letter-spacing: var(--challenge-hud-letter-spacing); /* web: 同上。値は字の大きさの 1/100 単位（12px で 1px）なので、--hud-label-font-size だけを上書きするときは字間も上書きする */
    --hud-label-rule-gap: var(--challenge-hud-label-rule-gap); /* web: 同上 */
    --hud-rule-list-gap: var(--challenge-hud-rule-list-gap); /* web: .objectives の margin-top */
    --hud-rule-width: 100%; /* web: modeHud は FadeRule を幅いっぱい、challenge は .rule の --challenge-hud-rule-width（画面 USS が上書き） */

    /* C2-b: Mantine Button の Subtle のホバー。Mantine の生成器の対象外なのでここに Web と同名で手書きする */
    /* C2-b: Mantine Button Subtle hover; outside the Mantine generator, so it is hand-written here under the Web name */
    --mantine-color-blue-light-hover: rgba(34, 139, 230, 0.2); /* web: dark の rgba(34, 139, 230, 0.2) */

    /* I-fix2: 通知の文字影。Web は notification/style.module.css:38 に直書きでトークンが無い。値はキーヒントの影と同じ（設計書 A-112） */
    /* I-fix2: notification text shadow; the Web writes it inline in notification/style.module.css:38 with no token. Same value as the key-hint shadow (design A-112) */
    --notification-text-shadow: 0.35px 0.35px 0 rgba(0, 0, 0, 0.8); /* web: 0.35px 0.35px 0 rgb(0 0 0 / 80%) */

    /* C2-c: GameScrollView のバーの幅（Mantine ScrollArea の既定 0.75rem）・つまみのホバー・ShortcutHintLabel の kbd と文の間（設計書 A-34・A-35） */
    /* C2-c: GameScrollView bar width (Mantine ScrollArea default 0.75rem), thumb hover, and the kbd-to-text gap of ShortcutHintLabel (design A-34, A-35) */
    --scrollarea-scrollbar-size: 12px; /* web: Mantine ScrollArea の scrollbarSize の既定。画面は祖先で上書きする */
    --game-scroll-view-thumb-hover: rgb(133, 135, 141); /* web: rgba(255, 255, 255, 0.5) を溝（--gauge-track）とポーズの面へ重ねて前計算 */
    --shortcut-hint-label-gap: 0px; /* web: 置く側の flex の gap。既定 0（KeyControlHint が --tutorial-key-hint-kbd-gap に上書き） */

    /* キー操作ヒントの字の影。Web の 0.35px は Chrome では字の縁に約 1 画素の暗い縁として出るが、UITK の SDF の影は字の面の下にほぼ隠れるので、縁の暗さを Web に合わせた値で描く */
    /* Key hint glyph shadow; Chrome renders the Web 0.35px as a ~1px dark rim, but the UITK SDF shadow hides under the face, so draw it with a value matching the Web rim darkness */
    --key-hint-text-shadow-face: 1px 1px 0 rgba(0, 0, 0, 0.8); /* look-exception: LX-86 */ /* web: --key-hint-text-shadow 0.35px 0.35px 0 rgb(0 0 0 / 80%)。ずれだけを変え、字の右下の縁の暗さと色を 1280・2560 で Web と比べて選んだ（I-fix3: 縁の輝度の低下の平均/中央は Web 74/84・78/87、0.35px は 13/10・20/17、1px は 49/52・66/80。0.7〜1.5px と α 0.8〜1 を比べ、縁の色の差が両解像度の合計で最小。α 1 は縁に黒い点が出る。残る差は Chrome の字の面が太いこと） */

    /* S2-hud: 画面の幕と列車乗車 HUD の面。Web が直書きする半透明（設計書 A-55） */
    /* S2-hud: the screen backdrop and the train riding HUD face, translucent colors the Web writes inline (design A-55) */
    --screen-backdrop-face: rgba(0, 0, 0, 0.42); /* web: App.module.css .backdrop の rgb(0 0 0 / 42%) */
    --train-riding-hud-face: rgba(31, 31, 31, 0.82); /* web: trainHud/style.module.css の color-mix(in srgb, var(--mantine-color-dark-8) 82%, transparent) */
    /* C3-a: スロット族（Slots）。つまみの既定は Web の var() のフォールバック、色は Web の CSS module の直書きを前計算した値（設計書 A-52） */
    /* C3-a: slot family (Slots); knob defaults are the Web var() fallbacks, colors precompute literals in the Web CSS modules (design A-52) */
    --slot-frame-face: rgba(50, 52, 67, 0.5); /* web: SlotFrame .slot の background rgb(50 52 67 / 50%) */
    --slot-frame-insufficient-opacity: 0.4; /* web: .slot[data-insufficient] の opacity: 0.4 */
    --slot-frame-catalog-face: rgb(124, 126, 136); /* web: .slot[data-catalog="true"] の background-color */
    --slot-frame-filled-face: rgb(254, 254, 254); /* web: .slot[data-filled="true"] の background-color */
    --slot-frame-selected-trim-face: rgb(50, 52, 67); /* web: .slot[data-selected][data-filled] の linear-gradient の帯の色 */
    --face-inset-color: rgb(20, 22, 29); /* web: var(--face-inset-color, rgb(20 22 29)) */
    --filled-face-inset: 0px; /* web: var(--filled-face-inset, 0px) */
    --bevel-inset: outset; /* web: var(--bevel-inset, )。Web の空文字（外側へ成長）を UITK はキーワード outset で表す。ホットバーは inset（設計書 A-42） */
    --sel-c1: rgb(5, 197, 245); /* web: var(--sel-c1, rgb(5 197 245)) */
    --sel-c2: var(--select-cyan); /* web: var(--sel-c2, var(--select-cyan)) */
    --sel-c3: rgb(28, 219, 255); /* web: var(--sel-c3, rgb(28 219 255)) */
    --selected-face-ring-inset: 0px; /* web: var(--selected-face-ring-inset, 0px) */
    --selected-face-bottom-trim: 0px; /* web: var(--selected-face-bottom-trim, 0px) */
    --icon-pad: 5px; /* web: slotContent.module.css .icon の var(--icon-pad, 5px) */
    --count-bottom: -3px; /* web: .count の var(--count-bottom, -3px) */
    --count-font-size: 19px; /* web: .count の var(--count-font-size, 19px) */
    --count-letter-spacing: 0px; /* web: .count の var(--count-letter-spacing, normal)。UITK の字間は字の大きさ/100 × 値なので em は ×100 の px で上書きする */
    --shortage-count-right: -2px; /* web: ItemSlot .shortageCount の var(--shortage-count-right, -2px) */
    --shortage-count-bottom: -4px; /* web: var(--shortage-count-bottom, -4px) */
    --shortage-count-font-size: 11px; /* web: var(--shortage-count-font-size, 11px) */
    --outlined-count-label-color: var(--count-text); /* web: .iconTextOutlineLight の字の色。slotContent.module.css の量バッジの黒は --count-text で一元管理 */
    --slot-grid-gap: 6.8px; /* web: SlotGrid .grid の var(--slot-grid-gap, 0.425rem) */
    --slot-grid-row-gap: var(--slot-grid-gap); /* web: var(--slot-grid-row-gap, var(--slot-grid-gap, 0.425rem))。祖先で gap だけ上書きしても行が追う（台帳「実測の結論」） */
    /* C3-b: 相互作用（ModeSwitch の選択肢の高さ・DialogFrame・モーダルの幕）。つまみの既定は Web の var() のフォールバックか Mantine Modal の既定（設計書 A-52） */
    /* C3-b: interaction (ModeSwitch option height, DialogFrame, modal backdrop); knob defaults are the Web var() fallbacks or Mantine Modal defaults (design A-52) */
    --mode-switch-option-height: 34.8px; /* web: ModeSwitch .option の var(--mode-switch-option-height, auto)。auto の実寸＝padding-block 5px×2＋本文の行 16px×1.55（C2-c の実測）。ビルドメニューは --build-menu-category-height へ上書き */
    --modal-size: 440px; /* web: Mantine Modal の --modal-size（size 既定 md = 27.5rem）。ModalHost の w={320} は Mantine の content の flex: 0 0 var(--modal-size) に負け、参照 3-modal の実寸は 440px */
    --modal-radius: var(--mantine-radius-default); /* web: Mantine Modal の --modal-radius の既定 */
    --mb-padding: var(--mantine-spacing-md); /* web: Mantine ModalBase の --mb-padding（padding 既定 md）。題の行の余白 */
    --dialog-frame-header-min-height: 60px; /* web: Mantine ModalBase の header の min-height: 60px（直書き） */
    --dialog-frame-body-padding: var(--mantine-spacing-lg); /* web: ModalHost の Modal.Body p="lg" */
    --dialog-frame-face: var(--mantine-color-body); /* web: Mantine ModalBase の content の背景（参照 3-modal の面 rgb(36,36,36)） */
    --modal-backdrop-face: rgba(0, 0, 0, 0.6); /* web: Modal.Overlay backgroundOpacity={0.6} の #000 */
    --modal-shadow-1-y: 1px; /* web: Mantine Modal の box-shadow（--mantine-shadow-xl）の層 1「0 1px 3px rgba(0,0,0,0.05)」（@mantine/core 8.3.18 の既定・--mantine-scale 1） */
    --modal-shadow-1-blur: 3px;
    --modal-shadow-1-spread: 0px;
    --modal-shadow-1-color: rgba(0, 0, 0, 0.05); /* web: rgba(0,0,0,0.05) */
    --modal-shadow-2-y: 36px; /* web: 層 2「0 36px 28px -7px rgba(0,0,0,0.05)」 */
    --modal-shadow-2-blur: 28px;
    --modal-shadow-2-spread: -7px;
    --modal-shadow-2-color: rgba(0, 0, 0, 0.05); /* web: rgba(0,0,0,0.05) */
    --modal-shadow-3-y: 17px; /* web: 層 3「0 17px 17px -7px rgba(0,0,0,0.04)」 */
    --modal-shadow-3-blur: 17px;
    --modal-shadow-3-spread: -7px;
    --modal-shadow-3-color: rgba(0, 0, 0, 0.04); /* web: rgba(0,0,0,0.04) */

    /* C4-b: 進捗の部品（Gauges）。ProgressArrowGlyph の drop-shadow の色（設計書 A-88） */
    /* C4-b: progress parts (Gauges); the ProgressArrowGlyph drop-shadow color (design A-88) */
    --progress-arrow-glyph-shadow: rgba(0, 0, 0, 0.45); /* web: ProgressArrowGlyph .glyph の drop-shadow(0 1px 1px rgb(0 0 0 / 45%)) の色 */

    /* C4-a: 液体のスロット族（Slots/Fluid）。縁の色のつまみ・量の基線（設計書 A-97・A-99） */
    /* C4-a: fluid slot family (Slots/Fluid); outline color knob and amount baseline (design A-97, A-99) */
    --outlined-count-label-stroke: var(--icon-text-stroke-light); /* web: .iconTextOutlineLight の -webkit-text-stroke の色。.iconTextOutlineDark の置き場（FluidSlot の量・ホットバーの番号）が --icon-text-stroke-dark に上書きする */
    --fluid-slot-fill-bottom-radius: 3px; /* web: FluidSlot .slot の overflow: hidden が切る枠の内側の角丸。--mantine-radius-sm 4px − 線 1px */
    --fluid-slot-amount-bottom: 3.3px; /* web: FluidSlot .amount の bottom: 0。行高は本文の --mantine-line-height-md 1.55 で、OutlinedCountLabel は行高 1 の基線で置くので、半行間の差 (1.55 - 1) / 2 × 12px = 3.3px だけ箱を上げる */

    /* C4-c: レシピ部品（RecipeRow・RecipeActionButton・RecipeListScrollView）。Web の CSS module の直書き色とつまみの既定（設計書 A-46・A-126）。半透明色は Web の α のまま書く（UI は sRGB 空間で合成する） */
    /* C4-c: recipe parts (RecipeRow, RecipeActionButton, RecipeListScrollView); Web CSS-module literal colors and knob defaults (design A-46, A-126). Translucent colors keep the Web alpha as-is (UI composites in sRGB) */
    --recipe-row-border: rgba(60, 145, 215, 0.12); /* web: RecipeBox .recipeBox の border rgb(60 145 215 / 12%) */
    --recipe-row-face: rgba(59, 80, 175, 0.1); /* web: .recipeBox の background rgb(59 80 175 / 10%) */
    --recipe-row-ring: rgba(20, 75, 135, 0.35); /* web: .recipeBox の box-shadow 0 0 0 1.2px rgb(20 75 135 / 35%) */
    --recipe-row-bracket: #2fd0f0; /* web: .recipeBox::before/::after の linear-gradient(#2fd0f0, #2fd0f0) */
    --recipe-row-glow: rgba(0, 205, 255, 0.25); /* web: .recipeBox の box-shadow 0 0 2px 0 rgb(0 205 255 / 25%) */
    --recipe-row-bracket-shadow: rgba(47, 188, 255, 0.3); /* web: .recipeBox::before/::after の filter drop-shadow(0 0 1px rgb(47 188 255 / 30%)) */
    --recipe-action-face-start: var(--recipe-action-background-start); /* web: .recipeActionButton の background: var(--recipe-action-background) */
    --recipe-action-face-middle: var(--recipe-action-background-middle);
    --recipe-action-face-end: var(--recipe-action-background-end);
    --recipe-action-border-width: 1px; /* web: Mantine Button の border calc(0.0625rem * scale) solid transparent（:disabled も 1px）。background の shorthand は padding-box 起点・repeat なので、枠の帯に隣の 1 枚の端が回り込む（A-128）。研究は border: 0 で 0px */
    --recipe-action-hover-start: #2680dd; /* web: .craftButton:hover:not(:disabled) の linear-gradient(90deg, #2680dd, #45bcf5, #6cebfa) */
    --recipe-action-hover-middle: #45bcf5;
    --recipe-action-hover-end: #6cebfa;
    --recipe-action-disabled-start: var(--recipe-action-background-start); /* web: .craftButton:disabled の background: var(--recipe-action-background)（無効でもグラデを保つ） */
    --recipe-action-disabled-middle: var(--recipe-action-background-middle);
    --recipe-action-disabled-end: var(--recipe-action-background-end);
    --recipe-action-text: var(--text-high-contrast); /* web: .recipeActionButton の color */
    --recipe-action-disabled-text: rgba(255, 255, 255, 0.8); /* web: .craftButton:disabled の color rgb(255 255 255 / 80%) */
    --recipe-action-disabled-opacity: 1; /* web: .craftButton:disabled の opacity: 1 */
    --recipe-action-width: var(--recipe-craft-button-width); /* web: .craftButton の width・min-width */
    --recipe-action-height: var(--recipe-action-button-height); /* web: .recipeActionButton の height・min-height */
    --recipe-action-padding-block: 0px; /* web: .craftButton の padding: 0 */
    --recipe-action-font-size: 12px; /* web: .craftButton の font-size */
    --recipe-action-letter-spacing: 12px; /* web: .craftButton の letter-spacing 0.12em。UITK の字間は字の大きさ/100 × 値なので ×100 の px（A-70） */
    --recipe-action-text-outline-width: 1px; /* web: .craftButton の text-shadow 4 枚（上下左右 1px）のずれ。UITK も同じ文の字 4 つをずらして重ねる。研究は 0px で影なし */
    --recipe-action-text-outline: rgba(0, 40, 80, 0.55); /* web: text-shadow の rgb(0 40 80 / 55%) */
    --recipe-action-active-offset: 1px; /* web: Mantine Button の .mantine-active:active の translateY(1px) */
    --research-action-disabled-face: rgb(50, 52, 67); /* web: research .researchButton:disabled の background。S4-research が --recipe-action-disabled-* へ当てる */
    --research-action-disabled-opacity: 0.6; /* web: research .researchButton:disabled の opacity: 0.6。S4-research が --recipe-action-disabled-opacity へ当てる */
    --recipe-list-gap: var(--recipe-entry-gap); /* web: RecipeListScrollArea の listGap。機械のレシピ選択は --machine-recipe-row-gap へ上書き */
}
