/* ランタイム既定コントロール（Button・TextField・Slider・Toggle・Scroller・Dropdown）の暗色。Web の Mantine テーマ相当で Web に対応トークンが無い */
/* Dark colors for runtime default controls (Button, TextField, Slider, Toggle, Scroller, Dropdown); Mantine-theme equivalents with no Web token */
:root {
    --control-text: #e6e8eb;
    --control-label: #9aa3ad;
    --control-border: #4a515c;
    --control-border-hover: #6b7380;
    --control-accent: #f2a640;
    --control-face: #353b45;
    --control-face-hover: #424955;
    --control-face-active: #2b3038;
    --control-input-face: #1f2329;
    --control-dragger-rim: #1b1d22;
    --control-scroller-track: rgba(255, 255, 255, 0.0008);
    --control-popup-face: #262a31;
    --control-popup-item-hover: #3a414c;

    /* GamePanel（default）の文字・罫線・下部の三角。Web の GamePanel/style.module.css が直書きする色 */
    --game-panel-text: #e8eaf0;
    --game-panel-title-shadow: rgba(0, 0, 0, 0.3735); /* web: rgba(0, 0, 0, 0.35) 面色(10,14,27)を背景にした厳密式 */
    --game-panel-rule-top-start: rgba(146, 148, 167, 0.1961); /* web: rgba(146, 148, 167, 0.42) 面色を背景にした厳密式（S7） */
    --game-panel-rule-top-peak: rgba(146, 148, 167, 0.3602); /* web: rgba(146, 148, 167, 0.59) 面色を背景にした厳密式（S7） */
    --game-panel-rule-top-end: rgba(146, 148, 167, 0.1653); /* web: rgba(146, 148, 167, 0.38) 面色を背景にした厳密式（S7） */
    --game-panel-rule-bottom-start: rgba(128, 132, 159, 0.1178); /* web: rgba(128, 132, 159, 0.3) 面色を背景にした厳密式（S7） */
    --game-panel-rule-bottom-peak: rgba(128, 132, 159, 0.2034); /* web: rgba(128, 132, 159, 0.42) 面色を背景にした厳密式（S7） */
    --game-panel-rule-bottom-end: rgba(128, 132, 159, 0.0946); /* web: rgba(128, 132, 159, 0.26) 面色を背景にした厳密式（S7） */
    --game-panel-triangle-face: rgba(94, 100, 128, 0.0764); /* web: rgba(94, 100, 128, 0.2) 面色(10,14,27)を背景にした厳密式 */

    /* PanelActionButton・ModeSwitch の Web の color-mix(in srgb, var(--gauge-track), var(--bevel-c2) N%) を前計算した面と、PanelActionButton の文字の縁 */
    --panel-action-hover-face: rgba(35, 38, 51, 0.9832); /* web: color-mix 22% = rgba(35, 38, 51, 0.844) α補正 */
    --mode-switch-selected-face: rgba(43, 46, 59, 0.9868); /* web: color-mix 30% = rgba(43, 46, 59, 0.86) α補正 */
    --panel-action-text-outline: rgba(0, 0, 0, 0.9293); /* web: rgb(0 0 0 / 70%) α補正 */

    /* ポーズの枠の面。Web の pauseMenu/style.module.css の .panel が直書きする色（ボタンの面 --gauge-track より明るい灰紺） */
    --pause-menu-face: rgba(16, 20, 28, 0.9961); /* web: rgb(16 20 28 / 92%) α補正 */

    /* ポーズの枠の線。Web の 1px rgb(255 255 255 / 24%) を枠の面 (16,20,28) の上で前計算した不透明色（半透明の線は Linear 合成で明るく出るため） */
    --pause-menu-border: rgb(73, 76, 82); /* web: rgb(255 255 255 / 24%) over (16,20,28) */

    /* Mantine（defaultColorScheme="dark"）の色。トースト（Notification withBorder）・送信ボタン（Button）・切断の赤字（Text c="red"）が使う */
    --mantine-dark-0: #c9c9c9;
    --mantine-dark-3: #696969;
    --mantine-dark-4: #424242;
    --mantine-dark-6: #2e2e2e;
    --color-accent: #1971c2; /* blue-8 = dark の blue filled */
    --color-accent-hover: #1864ab; /* blue-9 = dark の blue filled-hover */
    --color-danger: #e03131; /* red-8 = dark の red filled */
    --color-danger-text: #ff8787; /* red-4 = dark の red text */
}
