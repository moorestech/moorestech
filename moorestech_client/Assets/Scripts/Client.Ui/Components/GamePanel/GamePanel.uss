/* GamePanel の default variant。寸法と色は moorestech_web/webui/src/shared/ui/GamePanel/style.module.css を写す */
/* box-shadow（外周の影）は USS に無いので描かない（判断記録 D-6）。グラデーションは C# の描画が受け直したトークンで塗る */
/* Default variant of GamePanel; sizes and colors copy moorestech_web/webui/src/shared/ui/GamePanel/style.module.css */
/* box-shadow (outer shadow) has no USS equivalent and is not drawn (decision D-6); gradients are painted in C# from re-declared tokens */

.game-panel {
    display: flex;
    flex-direction: column;
    padding: 8px 10px 10px 28px;
    color: var(--game-panel-text);
    --game-panel-face: var(--surface-navy);
    --game-panel-edge-fade: var(--panel-edge-fade);
}

/* Web の ::before。top は calc(var(--panel-top, -8px) - 3.913894px) = -11.913894px、右・下・左は --panel-* の既定値 */
/* The Web ::before; top is calc(var(--panel-top, -8px) - 3.913894px) = -11.913894px, the other sides use the --panel-* defaults */
.game-panel__face {
    position: absolute;
    top: -11.913894px;
    right: -3px;
    bottom: -8px;
    left: -3px;
    --game-panel-face: var(--surface-navy);
    --game-panel-edge-fade: var(--panel-edge-fade);
}

/* タイトル行は高さ固定で、タイトルの拡大が罫線の位置を押し流さない */
/* The title row has a fixed height so enlarging the title never pushes the rules */
.game-panel__header {
    flex-direction: row;
    align-items: center;
    height: 19px;
}

/* Web の letter-spacing 0.02em は 19px で 0.38px。line-height 1 は USS に無いので余白を 0 にして行高へ寄せる */
/* The Web letter-spacing 0.02em is 0.38px at 19px; USS has no line-height, so zero spacing approximates line-height 1 */
.game-panel__title {
    margin: 0;
    padding: 0;
    font-size: 19px;
    -unity-font-style: normal;
    letter-spacing: 0.38px;
    color: var(--color-content-primary);
    text-shadow: 0.3px 0.3px 0 var(--game-panel-title-shadow);
    scale: 0.947 0.947;
    transform-origin: left center;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.game-panel__deco-line {
    height: 2px;
    margin: 4px 0;
}

/* 上線だけ 4 物理 px（1.565749px）上へ寄せ、ヘッダーのフローは保つ */
/* Lift only the top rule by four device pixels (1.565749px) while keeping the header flow */
.game-panel__deco-line--top {
    margin-top: 0;
    translate: 0 -1.565749px;
    --game-panel-rule-start: var(--game-panel-rule-top-start);
    --game-panel-rule-peak: var(--game-panel-rule-top-peak);
    --game-panel-rule-end: var(--game-panel-rule-top-end);
}

.game-panel__deco-line--bottom {
    margin-top: -1.4px;
    margin-bottom: 8px;
    --game-panel-rule-start: var(--game-panel-rule-bottom-start);
    --game-panel-rule-peak: var(--game-panel-rule-bottom-peak);
    --game-panel-rule-end: var(--game-panel-rule-bottom-end);
}

/* basis 0% で本文の高さを子孫の内容寸法へ依存させない（Web の .body と同じ方針） */
/* Basis 0% keeps the body height independent of descendant content size (same policy as the Web .body) */
.game-panel__body {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;
    flex-direction: column;
    min-height: 0;
}

/* 下部の三角 3 個の帯。本文の背後に置き、下端はパネルの外へ 7px はみ出す */
/* Band of three bottom triangles behind the body; its bottom pokes 7px outside the panel */
.game-panel__bottom-deco {
    position: absolute;
    right: 8%;
    bottom: -7px;
    left: 7%;
    height: 57px;
    --game-panel-deco: var(--game-panel-triangle-face);
}
