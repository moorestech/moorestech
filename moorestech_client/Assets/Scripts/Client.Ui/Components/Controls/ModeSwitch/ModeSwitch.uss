/* ModeSwitch。寸法と色は moorestech_web/webui/src/shared/ui/ModeSwitch/style.module.css を写す */
/* box-shadow のリングは USS に無いので bevel-1 幅の枠線で描く。選択面の color-mix は DerivedTokens.uss の前計算トークンで受ける */
/* ModeSwitch; sizes and colors copy moorestech_web/webui/src/shared/ui/ModeSwitch/style.module.css */
/* USS has no box-shadow, so the ring is a bevel-1 border; the selected face's color-mix comes from a precomputed DerivedTokens.uss token */

.mode-switch {
    flex-direction: row;
}

.mode-switch--vertical {
    flex-direction: column;
}

/* 既定テーマの .unity-button より強くするため親のクラスを前に付ける */
/* Prefix the parent class so these beat the default theme's .unity-button */
.mode-switch .mode-switch__option {
    --mode-switch-option-face: var(--gauge-track);
    --mode-switch-option-face-selected: var(--mode-switch-selected-face);
    --mode-switch-option-ring: var(--bevel-c1);
    --mode-switch-option-ring-selected: var(--bevel-c2);
    --mode-switch-option-text: var(--text-muted);
    --mode-switch-option-text-selected: var(--text-high-contrast);
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: var(--mode-switch-padding-block) var(--mode-switch-padding-inline);
    border-width: var(--bevel-1); /* look-exception: LX-3 */
    border-radius: var(--bevel-1);
    border-color: var(--mode-switch-option-ring);
    background-color: var(--mode-switch-option-face);
    color: var(--mode-switch-option-text);
    opacity: 1;
    transition-duration: 0s;
}

/* Web の選択肢にホバーと押下の表現は無いので既定テーマの変化を打ち消す */
/* Web options have no hover or press look, so cancel the default theme's changes */
.mode-switch .mode-switch__option:hover,
.mode-switch .mode-switch__option:active {
    scale: 1 1;
    border-color: var(--mode-switch-option-ring);
    background-color: var(--mode-switch-option-face);
}

/* 縦はサイドバーの並び。パネル高に合わせて伸ばさない */
/* Vertical is a sidebar list; options never stretch with the panel height */
.mode-switch--vertical .mode-switch__option {
    flex-grow: 0;
    flex-shrink: 0;
}

.mode-switch--horizontal .mode-switch__option--following {
    margin-left: var(--mode-switch-gap);
}

.mode-switch--vertical .mode-switch__option--following {
    margin-top: var(--mode-switch-gap);
}

/* 選択は青グラデを避け、明るい寒色面と高コントラスト文字で示す */
/* Selection avoids the blue gradient and uses a brighter cool face with high-contrast text */
.mode-switch .mode-switch__option--selected,
.mode-switch .mode-switch__option--selected:hover,
.mode-switch .mode-switch__option--selected:active {
    border-color: var(--mode-switch-option-ring-selected);
    background-color: var(--mode-switch-option-face-selected);
    color: var(--mode-switch-option-text-selected);
}

/* 全体の無効は選択中も含めて従属テキストへ減衰させる。既定テーマの半透明化はしない */
/* Disabling the whole switch fades every option, selected included, to secondary text without the default theme's translucency */
.mode-switch--disabled .mode-switch__option,
.mode-switch--disabled .mode-switch__option--selected {
    color: var(--mode-switch-option-text);
    opacity: 1;
}

.mode-switch__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}
