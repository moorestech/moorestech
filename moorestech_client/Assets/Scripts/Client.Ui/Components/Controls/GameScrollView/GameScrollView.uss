/* moorestech_client/Assets/Scripts/Client.Ui/Components/Controls/GameScrollView/GameScrollView.uss */
/* 本文のスクロール領域。Mantine ScrollArea（type=auto・バーは本文に重なり右端）と moorestech_web/webui/src/shared/ui/panelBodyScrollArea.module.css を写す */
/* 幅と内側は --scrollarea-scrollbar-size から GameScrollView.cs が計算する（size・size/5） */
/* Body scroll area copying Mantine ScrollArea (type=auto, bar overlaid at the right edge) and moorestech_web/webui/src/shared/ui/panelBodyScrollArea.module.css */
/* GameScrollView.cs computes width and inset from --scrollarea-scrollbar-size (size, size/5) */
.game-scroll-view {
    --game-scroll-view-scrollbar-size: var(--scrollarea-scrollbar-size);
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* バーは流れから外して本文に重ねる。本文の幅を削らない */
/* The bar leaves the flow and overlays the content without narrowing it */
.game-scroll-view .unity-scroll-view__vertical-scroller {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    border-width: 0;
    background-color: var(--gauge-track);
}

.game-scroll-view .unity-scroller__slider {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    margin: 0;
}

.game-scroll-view .unity-scroller .unity-base-slider__drag-container {
    width: 100%;
    margin: 0;
}

.game-scroll-view .unity-scroller .unity-base-slider__tracker {
    left: 0;
    width: 100%;
    border-width: 0;
    background-color: transparent;
}

/* Theme.uss の Mantine Slider 向け top: 50% が縦のつまみにも当たるので、溝の上端へ戻す */
/* Theme.uss's Mantine Slider top: 50% also hits the vertical thumb, so pin it back to the track top */
.game-scroll-view .unity-scroller .unity-base-slider__dragger {
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--bevel-c2);
}

.game-scroll-view .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--game-scroll-view-thumb-hover);
}
