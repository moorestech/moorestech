/* moorestech_client/Assets/Scripts/Client.Ui/Components/Controls/GameScrollView/GameScrollView.uss */
/* 本文のスクロール領域。Mantine ScrollArea（type=auto・バーは本文に重なり右端）と moorestech_web/webui/src/shared/ui/panelBodyScrollArea.module.css を写す */
/* 幅と内側は --scrollarea-scrollbar-size と --game-scroll-view-scrollbar-padding-ratio から GameScrollView.cs が計算する（size・size×比） */
/* 溝・つまみの色と縦バーの上下右の逃げはつまみ（既定は DerivedTokens.uss の :root。ここで既定を書くと祖先の上書きを潰す） */
/* Body scroll area copying Mantine ScrollArea (type=auto, bar overlaid at the right edge) and moorestech_web/webui/src/shared/ui/panelBodyScrollArea.module.css */
/* GameScrollView.cs computes width and inset from --scrollarea-scrollbar-size and --game-scroll-view-scrollbar-padding-ratio (size, size x ratio) */
/* Track and thumb colors and the vertical bar's top/bottom/right insets are knobs (defaults live on :root in DerivedTokens.uss; a default here would block ancestor overrides) */
.game-scroll-view {
    --game-scroll-view-scrollbar-size: var(--scrollarea-scrollbar-size);
    --game-scroll-view-scrollbar-padding-ratio-resolved: var(--game-scroll-view-scrollbar-padding-ratio);
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* バーは流れから外して本文に重ねる。本文の幅を削らない */
/* The bar leaves the flow and overlays the content without narrowing it */
.game-scroll-view .unity-scroll-view__vertical-scroller {
    position: absolute;
    top: var(--game-scroll-view-scrollbar-inset-top);
    right: var(--game-scroll-view-scrollbar-inset-right);
    bottom: var(--game-scroll-view-scrollbar-inset-bottom);
    margin: 0;
    border-width: 0;
    background-color: var(--game-scroll-view-track-face);
}

.game-scroll-view .unity-scroller__slider {
    flex-grow: 1;
    width: 100%;
    min-width: 0;
    margin: 0;
}

.game-scroll-view .unity-scroller .unity-base-slider__drag-container {
    width: 100%;
    margin: 0;
}

.game-scroll-view .unity-scroller .unity-base-slider__tracker {
    left: 0;
    width: 100%;
    border-width: 0;
    background-color: transparent;
}

/* Theme.uss の Mantine Slider 向け top: 50% が縦のつまみにも当たるので、溝の上端へ戻す */
/* Theme.uss's Mantine Slider top: 50% also hits the vertical thumb, so pin it back to the track top */
.game-scroll-view .unity-scroller .unity-base-slider__dragger {
    top: 0;
    left: 0;
    width: 100%;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--game-scroll-view-thumb-face);
}

.game-scroll-view .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--game-scroll-view-thumb-hover);
}
