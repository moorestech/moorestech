/* PanelActionButton。寸法と色は moorestech_web/webui/src/shared/ui/PanelActionButton/style.module.css を写す */
/* Web の color-mix（ホバー面）は USS に無いので DerivedTokens.uss の前計算トークンで受ける。4 方向 0.3px の text-shadow は文字の縁で近似する（幅は面を削らない --panel-action-text-outline-width） */
/* 縦の並びが溢れたとき Chrome はボタンを min-height: auto（文字の行の箱）まで縮めるので、min-height にその値を持つ */
/* PanelActionButton; sizes and colors copy moorestech_web/webui/src/shared/ui/PanelActionButton/style.module.css */
/* The Web color-mix (hover face) has no USS equivalent, so it comes from a precomputed DerivedTokens.uss token; the four-way 0.3px text-shadow is approximated by a text outline (width --panel-action-text-outline-width, which keeps the face) */
/* When a column overflows Chrome shrinks the button down to min-height: auto (the text line box), so min-height carries that value */

/* 既定テーマの .unity-button より強くするため 2 クラスで当てる */
/* Two classes so these beat the default theme's .unity-button */
.panel-action-button.unity-button {
    --panel-action-button-face: var(--gauge-track);
    --panel-action-button-face-hover: var(--panel-action-hover-face);
    --panel-action-button-text: var(--text-high-contrast);
    --panel-action-button-outline: var(--panel-action-text-outline);
    width: var(--panel-action-button-width);
    height: var(--panel-action-button-height);
    min-height: var(--panel-action-button-min-content-height);
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--panel-action-button-face);
    color: var(--panel-action-button-text);
    font-size: var(--panel-action-button-font-size);
    transition-duration: 0s;
}

/* ホバーは色相を変えず面だけを明るくする */
/* Hover brightens only the face, never the hue */
.panel-action-button.unity-button:hover {
    background-color: var(--panel-action-button-face-hover);
}

/* Web には押下の沈みが無いので既定テーマの translate を打ち消す */
/* The Web has no press sink, so cancel the default theme's translate */
.panel-action-button.unity-button:active {
    translate: 0 0;
    background-color: var(--panel-action-button-face-hover);
}

.panel-action-button__label {
    margin: 0;
    padding: 0;
    color: var(--panel-action-button-text);
    -unity-text-align: middle-center;
    -unity-text-outline-width: var(--panel-action-text-outline-width); /* look-exception: LX-2 */
    -unity-text-outline-color: var(--panel-action-button-outline);
    flex-grow: 1;
}
