/* web: moorestech_web/webui/src/shared/ui/ItemSlot/style.module.css の .shortageSlot・.shortageCount・[data-lack] を写す。z-index: 2 は後に足した子が上に描かれる順で写す */
/* web: copies .shortageSlot, .shortageCount and [data-lack] in moorestech_web/webui/src/shared/ui/ItemSlot/style.module.css; z-index: 2 maps to the later child drawing on top */
/* 白い縁の 2 層と基線の補正は OutlinedCountLabel が持ち、ここは置き場・大きさ・字の色だけを当てる */
/* OutlinedCountLabel owns the two outline layers and the baseline shift; this only places and sizes both layers and sets the glyph color */
.item-slot {
    --outlined-count-label-color: var(--count-text);
}

.item-slot__shortage {
    display: none;
    position: absolute;
    right: var(--shortage-count-right);
    bottom: var(--shortage-count-bottom);
    height: var(--shortage-count-font-size);
    font-size: var(--shortage-count-font-size);
}

.item-slot--shortage > .item-slot__shortage {
    display: flex;
}

.item-slot--lack {
    --outlined-count-label-color: var(--text-insufficient);
}
