/* web: features/blockInventory/train/style.module.css .body と details/station/trainStationNameSection.module.css .row（ローカルのつまみ無し） */
/* web: the Web train .body and the station name .row; no local knobs */
.train-body {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* Mantine ScrollArea（scrollbars 既定 xy）の縦バーは bottom: var(--sa-corner-width)＝縦バーの幅 12px（前例 ItemList.uss） */
/* Mantine ScrollArea (default scrollbars xy) puts the vertical bar at bottom: var(--sa-corner-width) = the bar's 12px width (precedent ItemList.uss) */
.train-body__scroll {
    --game-scroll-view-scrollbar-inset-bottom: var(--scrollarea-scrollbar-size);
    flex-grow: 1;
    min-height: 0;
    margin-top: var(--mode-switch-gap);
}

.train-station-name {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.train-station-name > .train-station-name__row-end {
    margin-left: var(--mode-switch-padding-inline);
}

/* 入力欄の幅は Web の UA 既定（size=20）の実測をトークンで当てる */
/* The field width applies the measured Web UA default (size=20) through a token */
.train-station-name > .train-station-name__input {
    width: var(--train-station-name-input-width);
}
