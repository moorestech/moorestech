/* web: details/machine/recipeSelection/machineRecipeSelectionList.module.css の .row・.name・[data-selected] の outline・.list のつまみ上書き（ユーザー裁定 2026-09-05「控えめ」）と listGap を写す / ports the row, name, selected outline, the list knob overrides and listGap */
/* 行間とつまみは祖先のクラスで上書きし、共有 RecipeRow・RecipeListScrollView の既定には及ばない */
/* The gap and knobs are overridden on an ancestor class and never reach the shared RecipeRow / RecipeListScrollView defaults */
.machine-recipe-selection-list {
    --recipe-list-gap: var(--machine-recipe-row-gap);
    --recipe-row-padding-block: 5.6px;
    --recipe-slot-size-max: 32px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* 高さ確定面では内容高を基準にせず器の残りだけを取り、フッタを押し縮めない（基準が内容高だとレシピが溢れたとき縮みをフッタと分け合う） */
/* On the height-determining panel take only the remaining space, not the content height, so the footer is never squeezed (a content-height basis shares the shrink with the footer when recipes overflow) */
.machine-section--fill-panel-height > .machine-recipe-selection-list {
    flex-basis: 0;
}

/* 押せる印の指は C# が OS カーソルへ要求する（USS の cursor はランタイムで効かない） */
/* The pressable pointer is requested on the OS cursor from C# (USS cursor does nothing at runtime) */
.machine-recipe-selection-row {
    min-width: 0;
}

/* Web の line-height: 1 は RecipeRow の秒数と同じく高さを字の大きさにして基線を 18.1% 下げる。下の 0.25rem は margin で写す（height は padding を含むため） */
/* The Web line-height: 1 sets the height to the font size and lowers the baseline by 18.1%, as the RecipeRow duration does; the 0.25rem below becomes a margin (height includes padding) */
.machine-recipe-selection-row__name {
    height: var(--recipe-info-text-size);
    margin: 0 0 4px 0;
    color: var(--text-muted);
    font-size: var(--recipe-info-text-size);
    padding: 0 var(--recipe-row-padding-inline);
    -unity-text-align: lower-left;
    translate: 0 18.1%;
}

.machine-recipe-selection-row__outline {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    border-width: 1px;
    border-color: var(--select-cyan);
}

.machine-recipe-selection-row--selected > .machine-recipe-selection-row__outline {
    display: flex;
}
