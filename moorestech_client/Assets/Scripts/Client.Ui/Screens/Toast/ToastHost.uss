/* web: Mantine Notifications の右下の積み（ToastHostView の入れ物）。出入りの時間は通知トークンを受け直す */
/* web: Mantine Notifications bottom-right stack (the ToastHostView container); fade durations re-read the notification tokens */
.toast-host {
    position: absolute;
    right: 16px;
    bottom: 16px;
    flex-direction: column;
    align-items: flex-end;
    --toast-host-enter-duration: var(--notification-enter-duration);
    --toast-host-exit-duration: var(--notification-exit-duration);
}
