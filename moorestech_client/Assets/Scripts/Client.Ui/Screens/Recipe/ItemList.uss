/* web: src/features/recipe/panels/ItemListPanel.tsx（style・GRID_STYLE・ScrollArea scrollbarSize）・ItemListPanel.module.css */
/* web: src/features/recipe/panels/ItemListPanel.tsx (style, GRID_STYLE, ScrollArea scrollbarSize), ItemListPanel.module.css */
.item-list {
    align-self: flex-start;
    align-items: flex-end;
}

/* 固定の寸法（件数で伸びない）とパネルの局所上書き */
/* Fixed size (never grows with the count) and the panel's local overrides */
.item-list #item-list-panel {
    width: 378px;
    height: 452px;
    --panel-top: -6.821px;
    --panel-bottom: -9.17px;
    --panel-left: -1.04px;
    --title-shift-x: 1.57px;
    --title-scale-x: 0.963;
    --title-scale-y: 0.861;
}

/* 透明な溝に白 88% のつまみ（ホバーでも同じ）、内側余白 0。calc の margin は ItemListView が下の 3 本から当てる */
/* Transparent track with a white 88% thumb (same on hover) and zero bar padding; ItemListView derives the calc margins from the three knobs below */
/* 縦バーの下端は Web では clip-inset + --sa-corner-width。参照の画素ではつまみが 277px（2560 は 415 物理 px）で、溝の長さは 388 − 4 = 384 にあたるので corner は 4px が残っている */
/* The Web bar bottom is clip-inset + --sa-corner-width; the reference thumb is 277px (415 physical px at 2560), i.e. a 388 - 4 = 384 track, so a 4px corner remains */
.item-list .item-list__scroll {
    --scrollarea-scrollbar-size: 4px;
    --game-scroll-view-track-face: var(--item-list-scroll-track-face);
    --game-scroll-view-thumb-face: var(--item-list-scroll-thumb-face);
    --game-scroll-view-thumb-hover: var(--item-list-scroll-thumb-face);
    --game-scroll-view-scrollbar-padding-ratio: 0;
    --game-scroll-view-scrollbar-inset-top: var(--tutorial-anchor-clip-inset);
    --game-scroll-view-scrollbar-inset-bottom: 16px; /* web: calc(var(--tutorial-anchor-clip-inset) + var(--sa-corner-width)) = 12 + 4 */
    --item-list-scroll-clip-inset: var(--tutorial-anchor-clip-inset);
    --item-list-scroll-margin-left-base: -0.43px; /* web: -3.561498px + 3.131498px（グリッドの内側の補正と旧 padding-left の打ち消し） */
    --item-list-scroll-margin-top-base: 12px; /* web: calc(12px - clip-inset) の 12px（つまみの縦位置合わせ） */
    margin-right: 4.435px;
}

/* GRID_STYLE。字間 0.12em は UITK の「字の大きさ/100 × 値」で 12px（A-70） */
/* GRID_STYLE; letter-spacing 0.12em is 12px in UITK's "font size / 100 x value" unit (A-70) */
.item-list #item-list-grid {
    --slot-size: 46.144px;
    --slot-grid-gap: 8.656px;
    --slot-grid-row-gap: 8.896px;
    --icon-pad: 5px;
    --count-bottom: -1px;
    --count-font-size: 16px;
    --count-letter-spacing: 12px;
    padding-bottom: var(--item-list-count-bleed);
}

/* 字間 0.12em の最後の字の後ろの字間（0.12 × 16px）。Chrome は足し UITK は足さないので SlotContent のつまみで受け直す */
/* The trailing 0.12em gap after the last glyph (0.12 x 16px); Chrome adds it and UITK does not, so the SlotContent knob takes it */
.item-list #item-list-grid .slot-content {
    --slot-content-count-trailing-spacing: 1.92px;
}
