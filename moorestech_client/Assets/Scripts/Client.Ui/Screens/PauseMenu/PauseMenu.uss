/* ポーズ画面の枠と並び。寸法は moorestech_web/webui/src/features/pauseMenu/style.module.css の .panel / .page を写す */
/* 最大高（--pause-menu-max-height = ステージ高 − 80px）は、層いっぱいの置き場の上下 40px の余白と枠の max-height 100% で作る */
/* Pause-menu frame and layout; sizes copy .panel / .page in moorestech_web/webui/src/features/pauseMenu/style.module.css */
/* The max height (--pause-menu-max-height = stage height - 80px) comes from the full-layer host's 40px top and bottom padding plus the frame's max-height 100% */

/* 置き場は層いっぱいに広げ、枠を上下左右の中央へ置く */
/* The host fills the layer and centers the frame both ways */
.pause-menu {
    --pause-menu-disconnected-text: var(--mantine-color-red-text);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 40px 0;
    justify-content: center;
    align-items: center;
}

/* 枠は Web の .panel そのまま: 面・1px の線・角丸 12px・padding 32px・幅 420px。文字の既定は Mantine の本文（白・16px） */
/* The frame is the Web .panel as is: face, 1px rule, 12px radius, 32px padding and 420px width; text defaults to the Mantine body (white, 16px) */
.pause-menu__panel {
    --pause-menu-panel-face: var(--pause-menu-face);
    --pause-menu-panel-border: var(--pause-menu-border);
    --pause-menu-panel-text: var(--text-high-contrast);
    width: 420px;
    max-height: 100%;
    padding: 32px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--pause-menu-panel-border);
    background-color: var(--pause-menu-panel-face);
    color: var(--pause-menu-panel-text);
    font-size: 16px;
}

/* 題は Mantine の Title order=1（UiTypographyClass.TitleOrder1）。下に Stack gap=md の 16px を空ける */
/* 題は全言語で 1 行に収まるので、行を Web の 34px×1.3 に固定する。UITK の字の自然な高さ（Latin 47・JP 50px）は Web の行より高く、字は行の中央からはみ出す（CSS の負の half-leading と同じ） */
/* The title is Mantine Title order=1 (UiTypographyClass.TitleOrder1), followed by the Stack gap=md 16px */
/* Every locale's title fits on one line, so the row is fixed at the Web 34px x 1.3; UITK's natural glyph height (Latin 47, JP 50px) exceeds it and the glyphs overflow from the center (as CSS negative half-leading does) */
.pause-menu__title {
    flex-shrink: 0;
    height: var(--title-order-1-row-height);
    margin-bottom: 16px;
}

/* 枠が最大高で止まったとき、本文だけがスクロールできるよう flex の高さ連鎖を子画面まで通す */
/* Pass the flex height chain down to the sub-page so only the body scrolls when the frame stops at its max height */
.pause-menu__panel,
.pause-menu__page,
.pause-menu__sub-page,
.pause-menu__sub-page-column {
    flex-shrink: 1;
    min-height: 0;
}

.pause-menu__page,
.pause-menu__sub-page,
.pause-menu__sub-page-column {
    flex-grow: 1;
    flex-direction: column;
}

.pause-menu__disconnected {
    margin: 0 0 16px 0;
    padding: 0;
    color: var(--pause-menu-disconnected-text);
    white-space: normal;
}

/* 横幅は本文の並びが決める。整理ボタン用の既定幅では長いメニュー名が折り返す */
/* The body column owns the width; the sort button's default width wraps long menu labels */
.pause-menu .panel-action-button.unity-button {
    width: auto;
}

/* 本文が溢れると Chrome と同じく本文（basis＝内容の高さ）と比で縮み、PanelActionButton の min-height（行の箱）で止まる */
/* On body overflow it shrinks in ratio with the body (basis = content height) as Chrome does, stopping at the PanelActionButton min-height (line box) */
.pause-menu__back {
    flex-shrink: 1;
}
