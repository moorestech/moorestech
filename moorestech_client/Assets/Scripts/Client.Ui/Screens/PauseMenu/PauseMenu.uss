/* ポーズ画面の枠と並び。寸法は moorestech_web/webui/src/features/pauseMenu/style.module.css の .panel / .page を写す */
/* 最大高（--pause-menu-max-height = ステージ高 − 80px）は、層いっぱいの置き場の上下 40px の余白と枠の max-height 100% で作る */
/* Pause-menu frame and layout; sizes copy .panel / .page in moorestech_web/webui/src/features/pauseMenu/style.module.css */
/* The max height (--pause-menu-max-height = stage height - 80px) comes from the full-layer host's 40px top and bottom padding plus the frame's max-height 100% */

/* 置き場は層いっぱいに広げ、枠を上下左右の中央へ置く */
/* The host fills the layer and centers the frame both ways */
.pause-menu {
    --pause-menu-disconnected-text: var(--color-danger-text);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 40px 0;
    justify-content: center;
    align-items: center;
}

/* 枠は Web の .panel そのまま: 面・1px の線・角丸 12px・padding 32px・幅 420px。文字の既定は Mantine の本文（白・16px） */
/* The frame is the Web .panel as is: face, 1px rule, 12px radius, 32px padding and 420px width; text defaults to the Mantine body (white, 16px) */
.pause-menu__panel {
    --pause-menu-panel-face: var(--pause-menu-face);
    --pause-menu-panel-border: var(--pause-menu-border);
    --pause-menu-panel-text: var(--text-high-contrast);
    width: 420px;
    max-height: 100%;
    padding: 32px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--pause-menu-panel-border);
    background-color: var(--pause-menu-panel-face);
    color: var(--pause-menu-panel-text);
    font-size: 16px;
}

/* 題は Mantine の Title order=1（34px・行高 1.3）。下に Stack gap=md の 16px を空ける */
/* The title is Mantine Title order=1 (34px, line height 1.3), followed by the Stack gap=md 16px */
.pause-menu__title {
    flex-shrink: 0;
    height: 44px;
    margin: 0 0 16px 0;
    padding: 0;
    font-size: 34px;
    -unity-text-align: middle-left;
}

/* 枠が最大高で止まったとき、本文だけがスクロールできるよう flex の高さ連鎖を子画面まで通す */
/* Pass the flex height chain down to the sub-page so only the body scrolls when the frame stops at its max height */
.pause-menu__panel,
.pause-menu__page,
.pause-menu__sub-page,
.pause-menu__body {
    flex-shrink: 1;
    min-height: 0;
}

.pause-menu__page,
.pause-menu__sub-page {
    flex-grow: 1;
    flex-direction: column;
}

.pause-menu__body {
    flex-grow: 1;
}

/* Web の Stack gap=md（16px）。USS に gap が無いので 2 つ目以降の子に上の余白を付ける */
/* Web Stack gap=md (16px); USS has no gap, so children after the first get a top margin */
.pause-menu__stack-item--following {
    margin-top: 16px;
}

/* PanelActionButton の margin: 0（2 クラス）に負けないよう、ボタンの間隔は部品のクラスを重ねて当てる */
/* Button gaps stack the component classes so they beat PanelActionButton's two-class margin: 0 */
.pause-menu .panel-action-button.unity-button.pause-menu__stack-item--following,
.pause-menu .panel-action-button.unity-button.pause-menu__back {
    margin-top: 16px;
}

.pause-menu__disconnected {
    margin: 0 0 16px 0;
    padding: 0;
    color: var(--pause-menu-disconnected-text);
    white-space: normal;
}

/* 横幅は本文の並びが決める。整理ボタン用の既定幅では長いメニュー名が折り返す */
/* The body column owns the width; the sort button's default width wraps long menu labels */
.pause-menu .panel-action-button.unity-button {
    width: auto;
}

.pause-menu__back {
    flex-shrink: 0;
}

/* 本文のスクロールバーは Web の panelBodyScrollArea（§8.10 のネイビーの溝・角の無い --bevel-c2 のつまみ・幅 12px で左右 2px 内側） */
/* The body scrollbar follows the Web panelBodyScrollArea (§8.10 navy track, square --bevel-c2 thumb, 12px wide with a 2px inset) */
.pause-menu__body .unity-scroller--vertical {
    --pause-menu-scroller-track: var(--gauge-track);
    --pause-menu-scroller-thumb: var(--bevel-c2);
    width: 12px;
    background-color: var(--pause-menu-scroller-track);
}

.pause-menu__body .unity-scroller .unity-base-slider__tracker {
    width: 12px;
    background-color: var(--pause-menu-scroller-track);
}

.pause-menu__body .unity-scroller .unity-base-slider__dragger {
    left: 2px;
    width: 8px;
    border-radius: 0;
    background-color: var(--pause-menu-scroller-thumb);
}
