+using System;
+
+namespace Client.Game.Greenhouse
+{
+    public class GreenhouseStarter
+    {
+        private readonly IrrigationSchedule _schedule;
+
+        public GreenhouseStarter(IrrigationSchedule schedule)
+        {
+            _schedule = schedule;
+        }
+
+        public void OnHandshakeArrived(GreenhouseHandshake handshake)
+        {
+            // 起動時に一度だけ初期レイアウトを適用する
+            // Apply the initial layout exactly once at startup
+            _schedule.ApplyFirstLayout(handshake.ValvePlans);
+        }
+    }
+}
