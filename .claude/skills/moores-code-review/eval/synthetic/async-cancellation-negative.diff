+++ b/moorestech_client/Assets/Scripts/Client.Common/Asset/AmbienceClipLoader.cs
@@ -0,0 +1,26 @@
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using UnityEngine;
+using UnityEngine.AddressableAssets;
+
+namespace Client.Common.Asset
+{
+    public static class AmbienceClipLoader
+    {
+        public static async UniTask<AudioClip> LoadClipAsync(string address, CancellationToken ct)
+        {
+            var handle = Addressables.LoadAssetAsync<AudioClip>(address);
+            await handle.ToUniTask(cancellationToken: ct);
+            return handle.Result;
+        }
+
+        // 起動時に1度だけ読む既定クリップ。プロセス寿命と一致するので中断手段を持たない
+        // Default clip read once at boot; its lifetime equals the process, so it takes no cancellation
+        public static AudioClip LoadDefaultClip(string address)
+        {
+            return Addressables.LoadAssetAsync<AudioClip>(address).WaitForCompletion();
+        }
+    }
+}
diff --git a/moorestech_client/Assets/Scripts/Client.Game/Ambience/AmbienceClipPlayer.cs b/moorestech_client/Assets/Scripts/Client.Game/Ambience/AmbienceClipPlayer.cs
