+using System.Threading;
+using Client.Common.Asset;
+using Cysharp.Threading.Tasks;
+using UnityEngine;
+
+namespace Client.Game.Ambience
+{
+    public class AmbienceClipPlayer : MonoBehaviour
+    {
+        [SerializeField] private AudioSource audioSource;
+        [SerializeField] private string defaultClipAddress;
+
+        private CancellationTokenSource _loadCancellationTokenSource;
+        private AudioClip _currentClip;
+
+        private void Awake()
+        {
+            _currentClip = AmbienceClipLoader.LoadDefaultClip(defaultClipAddress);
+            audioSource.clip = _currentClip;
+        }
+
+        public void SwitchBiome(string clipAddress)
+        {
+            // 前回のロードを打ち切ってから新しいトークンを作る
+            // Cancel the previous load before creating a new token
+            _loadCancellationTokenSource?.Cancel();
+            _loadCancellationTokenSource?.Dispose();
+            _loadCancellationTokenSource = CancellationTokenSource.CreateLinkedTokenSource(
+                this.GetCancellationTokenOnDestroy());
+
+            SwitchBiomeInternal(clipAddress, _loadCancellationTokenSource.Token).Forget();
+
+            #region Internal
+
+            async UniTaskVoid SwitchBiomeInternal(string address, CancellationToken token)
+            {
+                _currentClip = await AmbienceClipLoader.LoadClipAsync(address, token);
+
+                audioSource.clip = _currentClip;
+                audioSource.Play();
+            }
+
+            #endregion
+        }
+
+        private void OnDestroy()
+        {
+            _loadCancellationTokenSource?.Cancel();
+            _loadCancellationTokenSource?.Dispose();
+            audioSource.Stop();
+        }
+    }
+}
