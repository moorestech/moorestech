index 000000000..e5f6a7b8c
--- /dev/null
+++ b/moorestech_client/Assets/Scripts/Client.Cutscene/SkitLauncher.cs
@@ -0,0 +1,29 @@
+using UnityEngine.Playables;
+
+namespace Client.Cutscene
+{
+    // スキット設定を読み、カットシーン再生役へ引き渡す
+    // Reads skit configs and hands them to the cutscene player
+    public class SkitLauncher
+    {
+        private readonly CutscenePlayer _cutscenePlayer;
+
+        public SkitLauncher(CutscenePlayer cutscenePlayer)
+        {
+            _cutscenePlayer = cutscenePlayer;
+        }
+
+        public void LaunchSkit(SkitConfig skitConfig)
+        {
+            // 設定の速度指定は解決せずそのまま再生役へ渡す
+            // Pass the configured scale through without resolving it here
+            _cutscenePlayer.Play(skitConfig.CutsceneAsset, skitConfig.PlaybackScale);
+        }
+
+        public void LaunchDebugPreview(PlayableAsset cutsceneAsset)
+        {
+            // デバッグプレビューは倍速再生を明示指定する（この層の意図的な決定）
+            // Debug preview deliberately requests double speed (this layer's own policy)
+            _cutscenePlayer.Play(cutsceneAsset, 2f);
+        }
+    }
+
+    public record SkitConfig(PlayableAsset CutsceneAsset, float? PlaybackScale);
+}
