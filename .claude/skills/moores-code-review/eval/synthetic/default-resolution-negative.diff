diff --git a/moorestech_client/Assets/Scripts/Client.Cutscene/CutscenePlayer.cs b/moorestech_client/Assets/Scripts/Client.Cutscene/CutscenePlayer.cs
new file mode 100644
index 000000000..d4e5f6a7b
--- /dev/null
+++ b/moorestech_client/Assets/Scripts/Client.Cutscene/CutscenePlayer.cs
@@ -0,0 +1,30 @@
+using UnityEngine;
+using UnityEngine.Playables;
+
+namespace Client.Cutscene
+{
+    // カットシーンの再生と再生速度の適用を担当する
+    // Plays cutscenes and applies the playback scale
+    public class CutscenePlayer : MonoBehaviour
+    {
+        // 再生速度未指定時の既定値
+        // Default playback scale when unspecified
+        private const float DefaultPlaybackScale = 1f;
+
+        [SerializeField] private PlayableDirector playableDirector;
+
+        public void Play(PlayableAsset cutsceneAsset, float? argPlaybackScale)
+        {
+            // 未指定なら既定速度で再生する
+            // Resolve to the default scale when unspecified
+            var playbackScale = argPlaybackScale ?? DefaultPlaybackScale;
+
+            // タイムラインへ速度を適用して再生を開始する
+            // Apply the scale to the timeline and start playback
+            playableDirector.playableAsset = cutsceneAsset;
+            playableDirector.playableGraph.GetRootPlayable(0).SetSpeed(playbackScale);
+            playableDirector.Play();
+        }
+    }
+}
diff --git a/moorestech_client/Assets/Scripts/Client.Cutscene/SkitLauncher.cs b/moorestech_client/Assets/Scripts/Client.Cutscene/SkitLauncher.cs
