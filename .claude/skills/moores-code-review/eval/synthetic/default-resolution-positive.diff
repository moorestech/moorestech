--- /dev/null
+++ b/moorestech_client/Assets/Scripts/Client.Toast/NotificationRouter.cs
@@ -0,0 +1,28 @@
+using UniRx;
+
+namespace Client.Toast
+{
+    // 通知イベントを購読してトースト表示へ振り分ける
+    // Subscribes to notification events and routes them to toasts
+    public class NotificationRouter
+    {
+        private readonly ToastPresenter _toastPresenter;
+
+        public NotificationRouter(ToastPresenter toastPresenter, IObservable<NotificationRequest> onNotification)
+        {
+            _toastPresenter = toastPresenter;
+            onNotification.Subscribe(HandleNotification);
+        }
+
+        private void HandleNotification(NotificationRequest request)
+        {
+            // 表示時間未指定なら既定値で補完してから表示役へ渡す
+            // Fill the default duration when unspecified, then hand off to the presenter
+            var durationSeconds = request.DurationSeconds ?? ToastPresenter.DefaultDurationSeconds;
+            _toastPresenter.Show(request.Message, durationSeconds);
+        }
+    }
+
+    public record NotificationRequest(string Message, float? DurationSeconds);
+}
