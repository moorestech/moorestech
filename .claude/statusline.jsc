#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const lib = path.join(__dirname, 'statusline-lib');
const { colorPct, formatModel, formatCwdReversed, formatK, makeBar, truncate } = require(path.join(lib, 'format'));
const { sumTokens, getGitInfo, analyzeTranscript } = require(path.join(lib, 'sources'));
const { buildRateLimitLine } = require(path.join(lib, 'rate-limits'));

const BAR_WIDTH = 20;
const AUTOCOMPACT_BUFFER_RATIO = 0.165; // Autocompact buffer (~16.5% of context window)

// ── エントリポイント ──
// ── Entry point ──
let input = '';
process.stdin.on('data', chunk => input += chunk);
process.stdin.on('end', () => {
    // 生 stdin を claude-info 等から参照できるようダンプ
    // silent-ok: ダンプは補助用途 / 失敗しても statusline 本体は描かれ、claude-info 側で古さに気づく
    try { fs.writeFileSync(`${process.env.HOME}/.claude/last_statusline_input.json`, input); } catch {}
    try {
        console.log(buildStatusLine(JSON.parse(input || '{}')));
    } catch (error) {
        console.log(`[Error] ${error.message}`);
        console.log(`Stack: ${error.stack}`);
        console.log(`Input: ${input.slice(0, 500)}`);
    }
});

// ── ステータスライン構築 ──
// ── Build status line ──
function buildStatusLine(data) {
    const cwd = data.cwd || process.cwd();
    const ctxWin = data.context_window || {};
    const { firstUserMessage, lastUsage } = analyzeTranscript(data.transcript_path);

    const lines = [
        buildHeaderLine(data.model || {}, cwd, ctxWin, lastUsage),
        buildContextBar(ctxWin, lastUsage),
        buildRateLimitLine(Date.now(), data.rate_limits),
    ];
    if (firstUserMessage) lines.push(`🗣 ${truncate(firstUserMessage, 40)}`);
    return lines.join('\n');
}

// ヘッダー行: モデル名、コンテキスト%、git、cwd
// Header line: model name, context %, git, cwd
function buildHeaderLine(model, cwd, ctxWin, lastUsage) {
    const parts = [`[🤖${formatModel(model)} ${colorPct(calcContextPct(ctxWin, lastUsage))}]`];
    const gitInfo = getGitInfo(cwd);
    if (gitInfo) parts.push(gitInfo);
    parts.push(`📁${formatCwdReversed(cwd)}`);
    return parts.join('');
}

// コンテキストバー行
// Context bar line
function buildContextBar(ctxWin, lastUsage) {
    const effectiveMax = effectiveContextMax(ctxWin);
    const tokens = sumTokens(lastUsage);
    const ratio = Math.min(tokens / effectiveMax, 1);
    const pct = calcContextPct(ctxWin, lastUsage);
    return `Compact: ${makeBar(ratio, BAR_WIDTH)} [${colorPct(pct)}] ${formatK(tokens)}/${formatK(effectiveMax)}`;
}

function effectiveContextMax(ctxWin) {
    const contextMax = ctxWin.context_window_size || 200000;
    return Math.round(contextMax * (1 - AUTOCOMPACT_BUFFER_RATIO));
}

function calcContextPct(ctxWin, lastUsage) {
    if (typeof ctxWin.used_percentage === 'number') {
        return Math.min(100, Math.round(ctxWin.used_percentage / (1 - AUTOCOMPACT_BUFFER_RATIO)));
    }
    return Math.round(Math.min(sumTokens(lastUsage) / effectiveContextMax(ctxWin), 1) * 100);
}
