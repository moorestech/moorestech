"DepotBuild"
{
	"DepotID" "__DEPOT_ID_WINDOWS__"
	"contentroot" "__CONTENT_ROOT_WINDOWS__"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	"FileExclusion" "*.pdb"
	"FileExclusion" "**/*_BurstDebugInformation_DoNotShip/*"
	"FileExclusion" "**/*_BackUpThisFolder_ButDontShipItWithYourGame/*"
}
