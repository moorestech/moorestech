"DepotBuild"
{
	"DepotID" "__DEPOT_ID_MAC__"
	"contentroot" "__CONTENT_ROOT_MAC__"

	"FileMapping"
	{
		"LocalPath" "*"
		"DepotPath" "."
		"recursive" "1"
	}

	"FileExclusion" "**/*_BurstDebugInformation_DoNotShip/*"
	"FileExclusion" "**/*_BackUpThisFolder_ButDontShipItWithYourGame/*"
	"FileExclusion" "**/*.dSYM/*"
}
