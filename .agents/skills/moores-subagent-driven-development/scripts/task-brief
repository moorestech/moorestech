#!/usr/bin/env bash
# 実装計画から1タスク分の全文を抽出し、実装者が1回のReadで読める
# ファイルへ書き出す。これによりタスク本文がコントローラのコンテキストを
# 経由してペーストされることがなくなる。
#
# 使い方: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# デフォルトOUTFILE: <repo-root>/.superpowers/sdd/task-<N>-brief.md
# （worktreeごと。同一ワーキングツリー内の同時実行は共有する）
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "使い方: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "そのようなプランファイルはありません: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${n}-brief.md"
fi

# 対象Task見出しで開始し、別Task見出しまたは同レベル以下の非Task見出し
# （## 判断記録 等）で終了する。Task内の深い小見出しでは切らない。
awk -v n="$n" '
  /^```/ { infence = !infence; if (intask) print; next }
  !infence && /^#+[ \t]+/ {
    match($0, /^#+/); lvl = RLENGTH
    if ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) { intask = 1; tasklvl = lvl; print; next }
    if (intask && lvl <= tasklvl) intask = 0
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} が ${plan} 内に見つかりません（'Task ${n}' に一致する見出しなし）" >&2
  exit 3
fi

echo "書き込み完了 ${out}: $(wc -l < "$out" | tr -d ' ') 行"
