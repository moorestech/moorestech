+using System.Collections.Generic;
+using Core.Master;
+
+namespace Game.Aviary
+{
+    public class AviaryFeedCatalog
+    {
+        public IReadOnlyList<AviaryFeedEntry> Entries()
+        {
+            var entries = new List<AviaryFeedEntry>();
+            foreach (var element in MasterHolder.AviaryMaster.Feeds)
+            {
+                entries.Add(AviaryFeedFactory.CreateEntry(element));
+            }
+
+            return entries;
+        }
+    }
+}
