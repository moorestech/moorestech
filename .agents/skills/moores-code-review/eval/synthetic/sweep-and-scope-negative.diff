+using Game.Aviary;
+using Server.Util.MessagePack;
+
+namespace Server.Protocol.PacketResponse
+{
+    public class AviaryHatchProtocol : IPacketResponse
+    {
+        public const string Tag = "va:aviaryHatch";
+
+        private readonly AviaryHatchService _hatchService;
+
+        public AviaryHatchProtocol(AviaryHatchService hatchService)
+        {
+            _hatchService = hatchService;
+        }
+
+        public ProtocolMessagePackBase GetResponse(List<byte> payload)
+        {
+            var request = MessagePackSerializer.Deserialize<AviaryHatchMessagePack>(payload.ToArray());
+            var result = _hatchService.TryHatch(request.NestId, out var chick);
+            return new AviaryHatchResponseMessagePack(result, chick?.NestId ?? -1);
+        }
+    }
+}
