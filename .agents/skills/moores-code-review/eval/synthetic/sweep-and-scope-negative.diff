@@ -0,0 +1,32 @@
+using System.Collections.Generic;
+
+namespace Game.Aviary
+{
+    public class AviaryNestLookup
+    {
+        private readonly Dictionary<int, AviaryNest> _nests = new();
+
+        public void Register(AviaryNest nest)
+        {
+            _nests[nest.NestId] = nest;
+        }
+
+        // プレイヤーが送ってくる巣IDは存在しないことがある（撤去直後の要求など）
+        // Nest ids sent by players can be absent (e.g. a request right after removal)
+        public bool TryGetNest(int nestId, out AviaryNest nest)
+        {
+            return _nests.TryGetValue(nestId, out nest);
+        }
+    }
+}
