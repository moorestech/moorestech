@@ -0,0 +1,44 @@
+using System.Collections.Generic;
+
+namespace Game.Aviary
+{
+    public enum HatchResult
+    {
+        Hatched,
+        StillIncubating,
+        NestNotFound,
+    }
+
+    public class AviaryHatchService
+    {
+        private readonly AviaryNestLookup _nestLookup;
+        private readonly Dictionary<int, uint> _incubationTicks = new();
+        private uint _elapsedTicks;
+
+        public AviaryHatchService(AviaryNestLookup nestLookup)
+        {
+            _nestLookup = nestLookup;
+        }
+
+        public HatchResult TryHatch(int nestId, out AviaryChick chick)
+        {
+            chick = null;
+            if (!_nestLookup.TryGetNest(nestId, out var nest)) return HatchResult.NestNotFound;
+            if (_incubationTicks[nestId] + nest.RequiredTicks > _elapsedTicks) return HatchResult.StillIncubating;
+
+            chick = new AviaryChick(nestId);
+            _incubationTicks.Remove(nestId);
+            return HatchResult.Hatched;
+        }
+
+        public void Update()
+        {
+            _elapsedTicks++;
+        }
+    }
+}
