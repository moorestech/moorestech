+using UnityEngine;
+
+namespace Client.Game.Ambience
+{
+    public class AmbienceDirector : MonoBehaviour
+    {
+        [SerializeField] private AnimationCurve gustCurve;
+
+        private DesertWindProfileSource _windProfileSource;
+        private WindProfileHandle _handle;
+
+        public float LastSampledGust { get; private set; }
+
+        private void Awake()
+        {
+            _windProfileSource = new DesertWindProfileSource(gustCurve);
+            _handle = new WindProfileHandle(1f);
+        }
+
+        private void Update()
+        {
+            LastSampledGust = _windProfileSource.SampleGust(Time.time);
+            ApplyGust();
+        }
+
+        private void ApplyGust()
+        {
+            var strength = LastSampledGust * _handle.Strength;
+            RenderSettings.fogDensity = strength * 0.01f;
+        }
+    }
+}
