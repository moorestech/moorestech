+using UnityEngine;
+
+namespace Client.Game.Ambience
+{
+    public class DesertWindProfileSource : IWindProfileSource
+    {
+        private readonly AnimationCurve _gustCurve;
+
+        public DesertWindProfileSource(AnimationCurve gustCurve)
+        {
+            _gustCurve = gustCurve;
+        }
+
+        public float SampleGust(float seconds)
+        {
+            return _gustCurve.Evaluate(seconds);
+        }
+    }
+}
