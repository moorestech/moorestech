@@ -0,0 +1,26 @@
+using Game.Aviary;
+using Server.Util.MessagePack;
+
+namespace Server.Protocol.PacketResponse
+{
+    public class AviaryDebugProtocol : IPacketResponse
+    {
+        public const string Tag = "va:aviaryDebug";
+
+        private readonly AviaryHatchService _hatchService;
+
+        public AviaryDebugProtocol(AviaryHatchService hatchService)
+        {
+            _hatchService = hatchService;
+        }
+
+        public ProtocolMessagePackBase GetResponse(List<byte> payload)
+        {
+            var request = MessagePackSerializer.Deserialize<AviaryDebugMessagePack>(payload.ToArray());
+            _hatchService.ForceHatch(request.NestId, out var chick);
+            return new AviaryDebugResponseMessagePack(chick.NestId);
+        }
+    }
+}
