+++ b/moorestech_server/Assets/Scripts/Game.Aviary/AviaryHatchService.cs
@@ -0,0 +1,40 @@
+using System.Collections.Generic;
+
+namespace Game.Aviary
+{
+    public class AviaryHatchService
+    {
+        private readonly Dictionary<int, uint> _incubationTicks = new();
+
+        public uint ElapsedTicks { get; private set; }
+
+        public void Update()
+        {
+            ElapsedTicks++;
+            AdvanceIncubation();
+        }
+
+        public bool ForceHatch(int nestId, out AviaryChick chick)
+        {
+            chick = new AviaryChick(nestId);
+            _incubationTicks.Remove(nestId);
+            return true;
+        }
+
+        private void AdvanceIncubation()
+        {
+            foreach (var nestId in new List<int>(_incubationTicks.Keys))
+            {
+                _incubationTicks[nestId] = ElapsedTicks;
+            }
+        }
+    }
+}
