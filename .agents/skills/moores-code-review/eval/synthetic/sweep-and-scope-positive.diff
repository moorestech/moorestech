+++ b/moorestech_server/Assets/Scripts/Game.Aviary/AviaryFeedFactory.cs
@@ -0,0 +1,30 @@
+using Core.Master;
+using Mooresmaster.Model.AviaryModule;
+
+namespace Game.Aviary
+{
+    public static class AviaryFeedFactory
+    {
+        public static bool TryCreate(AviaryFeedMasterElement element, out AviaryFeed feed)
+        {
+            feed = new AviaryFeed(element.FeedGuid, element.Nutrition, element.DisplayName);
+            return true;
+        }
+
+        public static AviaryFeedEntry CreateEntry(AviaryFeedMasterElement element)
+        {
+            TryCreate(element, out var feed);
+            return new AviaryFeedEntry(feed.FeedGuid, feed.DisplayName, feed.Nutrition);
+        }
+    }
+}
diff --git a/moorestech_server/Assets/Scripts/Game.Aviary/AviaryFeedCatalog.cs b/moorestech_server/Assets/Scripts/Game.Aviary/AviaryFeedCatalog.cs
new file mode 100644
--- /dev/null
+++ b/moorestech_server/Assets/Scripts/Game.Aviary/AviaryFeedCatalog.cs
@@ -0,0 +1,34 @@
+using System.Collections.Generic;
+using Core.Master;
+
+namespace Game.Aviary
+{
+    public class AviaryFeedCatalog
+    {
+        public IReadOnlyList<AviaryFeedEntry> Entries()
+        {
+            var entries = new List<AviaryFeedEntry>();
+            foreach (var element in MasterHolder.AviaryMaster.Feeds)
+            {
+                if (!AviaryFeedFactory.TryCreate(element, out var feed)) continue;
+                entries.Add(CreateEntry(feed));
+            }
+
+            return entries;
+        }
+
+        private AviaryFeedEntry CreateEntry(AviaryFeed feed)
+        {
+            return new AviaryFeedEntry(feed.FeedGuid, feed.DisplayName, feed.Nutrition);
+        }
+    }
+}
