+using System.Threading;
+using Client.Common.Asset;
+using Cysharp.Threading.Tasks;
+using UnityEngine;
+
+namespace Client.Game.Ambience
+{
+    public class AmbienceClipPlayer : MonoBehaviour
+    {
+        [SerializeField] private AudioSource audioSource;
+
+        private CancellationTokenSource _loadCancellationTokenSource;
+        private AudioClip _currentClip;
+
+        public void SwitchBiome(string clipAddress)
+        {
+            _loadCancellationTokenSource = new CancellationTokenSource();
+            SwitchBiomeInternal(clipAddress);
+
+            #region Internal
+
+            async void SwitchBiomeInternal(string address)
+            {
+                var token = _loadCancellationTokenSource.Token;
+
+                // アドレスからクリップをロードする
+                // Load the clip from the address
+                _currentClip = await AmbienceClipLoader.LoadClipAsync(address);
+
+                audioSource.clip = _currentClip;
+                audioSource.Play();
+            }
+
+            #endregion
+        }
+
+        private void OnDestroy()
+        {
+            audioSource.Stop();
+        }
+    }
+}
