diff --git a/moorestech_client/Assets/Scripts/Client.Common/Asset/AmbienceClipLoader.cs b/moorestech_client/Assets/Scripts/Client.Common/Asset/AmbienceClipLoader.cs
new file mode 100644
--- /dev/null
+++ b/moorestech_client/Assets/Scripts/Client.Common/Asset/AmbienceClipLoader.cs
@@ -0,0 +1,20 @@
+using System.Threading;
+using Cysharp.Threading.Tasks;
+using UnityEngine;
+using UnityEngine.AddressableAssets;
+
+namespace Client.Common.Asset
+{
+    public static class AmbienceClipLoader
+    {
+        public static async UniTask<AudioClip> LoadClipAsync(string address, CancellationToken ct)
+        {
+            var handle = Addressables.LoadAssetAsync<AudioClip>(address);
+            await handle.ToUniTask(cancellationToken: ct);
+            return handle.Result;
+        }
+    }
+}
