+using UnityEngine;
+
+namespace Client.Game.Ambience
+{
+    public class WindAmbienceLayer : IAmbienceLayer
+    {
+        private readonly float _baseStrength;
+
+        public WindAmbienceLayer(float baseStrength)
+        {
+            _baseStrength = baseStrength;
+        }
+
+
+        public float Evaluate(float seconds) => _baseStrength * Mathf.Sin(seconds);
+    }
+}
