+using System;
+using System.Collections.Generic;
+using UniRx;
+using UnityEngine;
+
+namespace Client.Game.Ambience
+{
+    public class AmbienceMixer : MonoBehaviour
+    {
+        [SerializeField] private AnimationCurve rainCurve;
+
+        private readonly List<IAmbienceLayer> _layers = new();
+        private IDisposable _weatherSubscription;
+
+        public float MixedLevel { get; private set; }
+
+        private void Awake()
+        {
+            _layers.Add(new RainAmbienceLayer(rainCurve));
+            _layers.Add(new WindAmbienceLayer(0.4f));
+            _weatherSubscription = WeatherChannel.OnWeatherChanged.Subscribe(_ => Rebuild());
+        }
+
+        private void OnDestroy()
+        {
+            _weatherSubscription.Dispose();
+        }
+
+        private void Rebuild()
+        {
+            var total = 0f;
+            foreach (var layer in _layers) total += layer.Evaluate(Time.time);
+            MixedLevel = total / _layers.Count;
+        }
+    }
+}
