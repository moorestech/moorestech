+using System;
+using System.Collections.Generic;
+
+namespace Client.Game.Greenhouse
+{
+    public class IrrigationSchedule
+    {
+        public IReadOnlyList<ValvePlan> Plans => _plans;
+        private readonly List<ValvePlan> _plans = new();
+        private int _activeValveCount;
+
+        public IrrigationSchedule()
+        {
+            _activeValveCount = 0;
+        }
+
+        public void Initialize(IReadOnlyList<ValvePlan> initialPlans)
+        {
+            // 初期レイアウト到着までは空。実値はこのメソッドが一度だけ流し込む
+            // Empty until the initial layout arrives; this method feeds the real values exactly once
+            _plans.Clear();
+            _plans.AddRange(initialPlans);
+        }
+
+        public bool TryRunValve(int valveIndex, float waterAmount)
+        {
+            // ガードはすべてメソッド直下に並べる
+            // All guards line up at the top of the method
+            if (valveIndex < 0 || _plans.Count <= valveIndex) return false;
+            if (waterAmount <= 0f) return false;
+            if (_plans[valveIndex].IsSuspended) return false;
+
+            RunValveCore();
+            return true;
+
+            #region Internal
+
+            void RunValveCore()
+            {
+                _plans[valveIndex].Accumulate(waterAmount);
+                _activeValveCount++;
+            }
+
+            #endregion
+        }
+
+        public void ApplyValveUpdate(int valveIndex, float accumulated)
+        {
+            // 毎イベント呼ばれる購読ハンドラ（初期化ではない）
+            // A per-event subscription handler, not initialization
+            if (valveIndex < 0 || _plans.Count <= valveIndex) return;
+            _plans[valveIndex].SetAccumulated(accumulated);
+        }
+
+        public bool TryDrainAll(float minimumReserve)
+        {
+            var drained = DrainAllCore();
+            return drained;
+
+            #region Internal
+
+            bool DrainAllCore()
+            {
+                // 条件はすべてこのローカル関数側に一貫して集めている（割れていなければ配置は自由）
+                // All conditions live consistently inside this local function; placement is free as long as it is not split
+                if (_plans.Count == 0) return false;
+                if (minimumReserve < 0f) return false;
+                if (_activeValveCount == 0) return false;
+
+                foreach (var plan in _plans) plan.SetAccumulated(minimumReserve);
+                _activeValveCount = 0;
+                return true;
+            }
+
+            #endregion
+        }
+    }
+}
